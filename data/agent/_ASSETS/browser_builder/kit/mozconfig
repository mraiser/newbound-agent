# mozconfig — build configuration for Firefox 128 ESR (noobscape)
#
# See: https://firefox-source-docs.mozilla.org/setup/configuring_build_options.html
# This file is copied into the source tree as ./mozconfig by build.sh.

# Build the browser (as opposed to Thunderbird, etc.).
ac_add_options --enable-application=browser

# Keep all build output in one predictable objdir so build.sh can find the
# resulting binary at obj-firefox/dist/bin/firefox.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-firefox

# Use the toolchains build.sh's deps stage staged into ~/.mozbuild (clang,
# node, cbindgen, and the compile sysroot with its GTK/pango/pulse headers)
# — this is what lets the build run with no root access and no system dev
# packages. no-update: never re-resolve them against the CI cache, whose
# digest lookup requires a real mozilla-central checkout.
ac_add_options --enable-bootstrap=no-update

# Point configure at the toolchains stage_deps staged under ~/.mozbuild. The
# no-update bootstrap only *enables* these paths to be read; it does not set
# CC/CXX, and the build runs with a stripped environment (no compiler on PATH),
# so without these explicit exports configure aborts with
# "Cannot find the target C compiler". $HOME/.mozbuild is where deps put them.
CC="$HOME/.mozbuild/clang/bin/clang"
CXX="$HOME/.mozbuild/clang/bin/clang++"
export CC CXX

# The staged clang dir carries the full LLVM toolchain (llvm-as, lld, llvm-ar,
# llvm-nm, llvm-ranlib, llvm-objcopy, llvm-strip). Configure looks each tool up
# by bare name, so put it on PATH AND name them explicitly (the build env is
# stripped; nothing else provides them). Use the LLVM integrated assembler and
# lld to match the clang-19 toolchain.
CLANG_BIN="$HOME/.mozbuild/clang/bin"
PATH="$CLANG_BIN:$PATH"
AS="$CLANG_BIN/clang"
AS_IS_LLVM=1
LDFLAGS="-fuse-ld=lld"
AR="$CLANG_BIN/llvm-ar"
NM="$CLANG_BIN/llvm-nm"
RANLIB="$CLANG_BIN/llvm-ranlib"
OBJCOPY="$CLANG_BIN/llvm-objcopy"
STRIP="$CLANG_BIN/llvm-strip"
# Point DUMP_SYMS at the no-op stub in ~/.mozbuild/.hostbin (build.sh provisions
# it). An explicit DUMP_SYMS makes moz.configure SKIP the `mach artifact
# toolchain` bootstrap, which fails on a tarball (no VCS revision to resolve).
DUMP_SYMS="$HOME/.mozbuild/.hostbin/dump_syms"
export PATH AS AS_IS_LLVM LDFLAGS AR NM RANLIB OBJCOPY STRIP DUMP_SYMS

# Release-style build: optimized, no debug assertions.
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Use unbranded ("Nightly") branding. Official Firefox branding requires
# permission from Mozilla; leave this commented unless you have it.
# ac_add_options --enable-official-branding

# Speed up rebuilds if sccache is installed (optional).
# ac_add_options --with-ccache=sccache

# Reduce noise / footprint for a headless build environment. The crashreporter
# is REQUIRED to be disabled for a tarball build: with it enabled, configure
# bootstraps dump_syms via `mach artifact toolchain`, which needs a VCS checkout
# with a resolvable revision ('No such remote origin') and fails. An automation
# browser has no use for the crashreporter (or the updater) anyway.
ac_add_options --disable-crashreporter
ac_add_options --disable-updater

# No WASI sysroot on this box: build third-party libs natively instead of
# wasm-sandboxing them (configure's own suggested fallback).
ac_add_options --without-wasm-sandboxed-libraries
