globals + persists botd.properties.\n      const next = on ? \"off\" : \"on\";\n      const r = mEnv(await invoke(\"agent\", \"model\", \"set_setting\", { key: \"PLAN_AUTONOMY\", value: next }));\n      mindNote(\"loop\", r && r.status === \"ok\" ? `plan autonomy ${next}` : \"set_setting failed\", !(r && r.status === \"ok\"));\n      loadMind();\n    });\n    act(\"set-plansteps\").addEventListener(\"click\", async () => {\n      const n = parseInt(host.querySelector(\".ag-plansteps\").value, 10);\n      if (isNaN(n) || n < 1) { mindNote(\"loop\", \"max steps must be a number ≥ 1\", true); return; }\n      const r = mEnv(await invoke(\"agent\", \"model\", \"set_setting\", { key: \"MAX_PLAN_STEPS\", value: String(n) }));\n      mindNote(\"loop\", r && r.status === \"ok\" ? `max plan steps set to ${n}/item` : \"set_setting failed\", !(r && r.status === \"ok\"));\n      loadMind();\n    });","old":"    act(\"set-drive\").addEventListener(\"click\", async () => {\n      const n = parseInt(host.querySelector(\".ag-drive\").value, 10);\n      if (isNaN(n) || n < 0) { mindNote(\"loop\", \"drive must be a number ≥ 0\", true); return; }\n      const r = mEnv(await invoke(\"agent\", \"executive\", \"set_drive\", { acts_per_hour: n }));\n      mindNote(\"loop\", r && r.status === \"ok\" ? `drive set to ${n}/hr` : \"set_drive failed\", !(r && r.status === \"ok\"));\n      loadMind();\n    });","patch_id":"p147","time":1792495625419},{"author":"agent","facet":"js","label":"agent cells opt into light markdown","new":"    renderRich(body, entry.text ?? \"\", entry.kind === \"agent\");\n    div.appendChild(body);","old":"    renderRich(body, entry.text ?? \"\");\n    div.appendChild(body);","patch_id":"p148","time":1792596748094},{"author":"agent","facet":"js","label":"renderRich: light markdown renderer for agent prose","new":"  /** think-folds + fenced code; agent prose (md=true) gets light markdown,\n   *  everything else stays text. */\n  function renderRich(el, raw, md) {\n    let text = String(raw);\n    const think = text.match(/<think>([\\s\\S]*?)<\\/think>/);\n    if (think) {\n      const det = document.createElement(\"details\");\n      det.className = \"ag-think\";\n      const sum = document.createElement(\"summary\");\n      sum.textContent = \"thinking…\";\n      det.append(sum, document.createTextNode(think[1].trim()));\n      el.appendChild(det);\n      text = text.replace(think[0], \"\").trim();\n    }\n    const parts = text.split(/```([\\s\\S]*?)```/);\n    parts.forEach((part, i) => {\n      if (!part.trim()) return;\n      if (i % 2 === 1) {\n        const pre = document.createElement(\"pre\");\n        pre.textContent = part.replace(/^[a-z:.\\-\\d]*\\n/i, \"\");\n        el.appendChild(pre);\n      } else if (md) {\n        const html = mdBlocks(part);\n        if (!html) return;\n        const d = document.createElement(\"div\");\n        d.className = \"ag-md\";\n        d.innerHTML = html;\n        el.appendChild(d);\n      } else {\n        const p = document.createElement(\"div\");\n        p.textContent = part.trim();\n        el.appendChild(p);\n      }\n    });\n  }\n\n  // ── light markdown (agent prose only) ────────────────────────────────\n  // ESCAPE FIRST, then a small safe subset: headings, lists (nested by\n  // indent; ordered lists keep their start so a fence mid-list doesn't\n  // renumber), quotes, rules, GFM tables, paragraphs; inline code, bold,\n  // italic, strike, links (http(s) / relative / #anchor only). Raw HTML\n  // from the model never reaches the DOM.\n  const mdEsc = (s) => s.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n  const mdEmph = (t) => t\n    .replace(/\\*\\*(\\S(?:[^*\\n]*?\\S)?)\\*\\*/g, \"<strong>$1</strong>\")\n    .replace(/(^|\\W)__(\\S(?:[^_\\n]*?\\S)?)__(?!\\w)/g, \"$1<strong>$2</strong>\")\n    .replace(/~~(\\S(?:[^~\\n]*?\\S)?)~~/g, \"<del>$1</del>\")\n    .replace(/(^|[^*\\w])\\*(\\S(?:[^*\\n]*?\\S)?)\\*(?![*\\w])/g, \"$1<em>$2</em>\")\n    .replace(/(^|\\W)_(\\S(?:[^_\\n]*?\\S)?)_(?!\\w)/g, \"$1<em>$2</em>\");\n  function mdInline(s) {\n    const stash = []; // code spans + links are held out of the emphasis pass\n    const hold = (h) => \"\\u0001\" + (stash.push(h) - 1) + \"\\u0001\";\n    let t = mdEsc(s).replace(/`([^`\\n]+)`/g, (_, c) => hold(\"<code>\" + c + \"</code>\"));\n    t = t.replace(/\\[([^\\]\\n]+)\\]\\(([^)\\s]+)\\)/g, (m, txt, url) =>\n      /^(https?:\\/\\/|\\/|\\.\\.?\\/|#)/i.test(url)\n        ? hold(`<a href=\"${url}\" target=\"_blank\" rel=\"noopener\">${mdEmph(txt)}</a>`) : m);\n    t = mdEmph(t);\n    for (let n = 0; n < 3 && t.includes(\"\\u0001\"); n++)\n      t = t.replace(/\\u0001(\\d+)\\u0001/g, (_, k) => stash[+k]);\n    return t;\n  }\n  function mdBlocks(text) {\n    const lines = text.replace(/\\r\\n?/g, \"\\n\").split(\"\\n\");\n    const isSep = (l) => l.includes(\"|\") && /^\\s*\\|?\\s*:?-+:?\\s*(\\|\\s*:?-+:?\\s*)*\\|?\\s*$/.test(l);\n    const cells = (l) => l.trim().replace(/^\\||\\|$/g, \"\").split(\"|\").map((c) => c.trim());\n    let html = \"\", para = [], quote = [], gap = false;\n    const lists = []; // open lists, innermost last: {tag, indent}\n    const flushPara = () => { if (para.length) html += \"<p>\" + para.map(mdInline).join(\"<br>\") + \"</p>\"; para = []; };\n    const flushQuote = () => { if (quote.length) html += \"<blockquote>\" + quote.map(mdInline).join(\"<br>\") + \"</blockquote>\"; quote = []; };\n    const closeLists = () => { while (lists.length) html += \"</li></\" + lists.pop().tag + \">\"; };\n    const flush = () => { flushPara(); flushQuote(); closeLists(); };\n    for (let i = 0; i < lines.length; i++) {\n      const ln = lines[i];\n      let m;\n      if (!ln.trim()) { flushPara(); flushQuote(); gap = true; continue; }\n      if (/^\\s{0,3}([-*_])(\\s*\\1){2,}\\s*$/.test(ln)) { flush(); html += \"<hr>\"; gap = false; continue; }\n      if ((m = ln.match(/^\\s{0,3}(#{1,6})\\s+(.*?)(?:\\s+#+)?\\s*$/))) {\n        flush(); const n = m[1].length; html += `<h${n}>${mdInline(m[2])}</h${n}>`; gap = false; continue;\n      }\n      if (ln.includes(\"|\") && isSep(lines[i + 1] ?? \"\")) {\n        flush();\n        const al = cells(lines[i + 1]).map((c) => c.endsWith(\":\") ? (c.startsWith(\":\") ? \"center\" : \"right\") : \"\");\n        const row = (l, tg) => \"<tr>\" + cells(l).map((c, k) =>\n          `<${tg}${al[k] ? ` style=\"text-align:${al[k]}\"` : \"\"}>${mdInline(c)}</${tg}>`).join(\"\") + \"</tr>\";\n        let t = \"<div class=\\\"ag-md-table\\\"><table><thead>\" + row(ln, \"th\") + \"</thead><tbody>\";\n        for (i += 2; i < lines.length && lines[i].includes(\"|\") && lines[i].trim(); i++) t += row(lines[i], \"td\");\n        i--; html += t + \"</tbody></table></div>\"; gap = false; continue;\n      }\n      if ((m = ln.match(/^\\s{0,3}>\\s?(.*)$/))) { flushPara(); closeLists(); quote.push(m[1]); gap = false; continue; }\n      if ((m = ln.match(/^(\\s*)([-*+]|(\\d{1,9})[.)])\\s+(.*)$/))) {\n        flushPara(); flushQuote();\n        const indent = m[1].replace(/\\t/g, \"    \").length, tag = m[3] ? \"ol\" : \"ul\";\n        const start = m[3] && +m[3] !== 1 ? ` start=\"${+m[3]}\"` : \"\";\n        while (lists.length && lists[lists.length - 1].indent > indent + 1) html += \"</li></\" + lists.pop().tag + \">\";\n        const top = lists[lists.length - 1];\n        if (!top || indent >= top.indent + 2) { html += `<${tag}${start}><li>`; lists.push({ tag, indent }); }\n        else if (top.tag !== tag) { html += `</li></${lists.pop().tag}><${tag}${start}><li>`; lists.push({ tag, indent }); }\n        else html += \"</li><li>\";\n        html += mdInline(m[4]); gap = false; continue;\n      }\n      if (lists.length && /^\\s/.test(ln)) { html += (gap ? \"<br><br>\" : \"<br>\") + mdInline(ln.trim()); gap = false; continue; }\n      closeLists(); flushQuote();\n      para.push(ln.trim()); gap = false;\n    }\n    flush();\n    return html;\n  }","old":"  /** think-folds + fenced code; everything else stays text. */\n  function renderRich(el, raw) {\n    let text = String(raw);\n    const think = text.match(/<think>([\\s\\S]*?)<\\/think>/);\n    if (think) {\n      const det = document.createElement(\"details\");\n      det.className = \"ag-think\";\n      const sum = document.createElement(\"summary\");\n      sum.textContent = \"thinking…\";\n      det.append(sum, document.createTextNode(think[1].trim()));\n      el.appendChild(det);\n      text = text.replace(think[0], \"\").trim();\n    }\n    const parts = text.split(/```([\\s\\S]*?)```/);\n    parts.forEach((part, i) => {\n      if (!part.trim()) return;\n      if (i % 2 === 1) {\n        const pre = document.createElement(\"pre\");\n        pre.textContent = part.replace(/^[a-z:.\\-\\d]*\\n/i, \"\");\n        el.appendChild(pre);\n      } else {\n        const p = document.createElement(\"div\");\n        p.textContent = part.trim();\n        el.appendChild(p);\n      }\n    });\n  }","patch_id":"p149","time":1792596771307},{"author":"agent","facet":"css","label":"styles for light-markdown agent prose (.ag-md)","new":".ag-think summary { cursor: pointer; }\n\n/* agent prose — light markdown (renderRich md path) */\n.ag-md { white-space: normal; line-height: 1.5; }\n.ag-md + .ag-md, .ag-md + pre, pre + .ag-md { margin-top: 6px; }\n.ag-md > :first-child { margin-top: 0; }\n.ag-md > :last-child { margin-bottom: 0; }\n.ag-md p { margin: 0 0 0.6em; }\n.ag-md h1, .ag-md h2, .ag-md h3, .ag-md h4, .ag-md h5, .ag-md h6 {\n  margin: 0.9em 0 0.4em; line-height: 1.25; font-weight: 600; }\n.ag-md h1 { font-size: 1.3em; }\n.ag-md h2 { font-size: 1.18em; }\n.ag-md h3 { font-size: 1.06em; }\n.ag-md h4, .ag-md h5, .ag-md h6 { font-size: 1em; }\n.ag-md ul, .ag-md ol { margin: 0 0 0.6em; padding-left: 1.5em; }\n.ag-md li { margin: 0.2em 0; }\n.ag-md li > ul, .ag-md li > ol { margin: 0.2em 0 0; }\n.ag-md code { font-family: var(--mono, ui-monospace, monospace); font-size: 0.88em;\n  background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; }\n.ag-md blockquote { margin: 0 0 0.6em; padding: 2px 0 2px 10px;\n  border-left: 3px solid var(--line); color: var(--text-dim); }\n.ag-md hr { border: none; border-top: 1px solid var(--line); margin: 0.8em 0; }\n.ag-md a { color: var(--accent, #f0a63c); }\n.ag-md .ag-md-table { overflow-x: auto; margin: 0 0 0.6em; }\n.ag-md table { border-collapse: collapse; font-size: 0.95em; }\n.ag-md th, .ag-md td { border: 1px solid var(--line); padding: 3px 8px;\n  text-align: left; vertical-align: top; }\n.ag-md th { background: var(--panel); font-weight: 600; }","old":".ag-think summary { cursor: pointer; }","patch_id":"p150","time":1792596780870},{"author":"agent","facet":"html","label":"mind: plan steps/hr field; acts/hr + plan toggle titles describe the worker split","new":"            <label class=\"lbl\" title=\"executive drive: idle memory-upkeep acts per hour (reverify, connect, wonder, distill). Plan items do not use it - they have their own worker.\">acts/hr <input class=\"ag-drive\" type=\"number\" min=\"0\" value=\"4\"></label>\n            <button class=\"ag-mind-btn\" data-act=\"set-drive\">set</button>\n          </span>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"plan-toggle\"\n              title=\"toggle PLAN_AUTONOMY (persists across restarts) - when armed the plan worker steps accepted / in-progress kb.plan items back to back on its own thread, and goes quiet (no LLM calls) when none are eligible\">plan autonomy…</button>\n            <label class=\"lbl\">max steps/item <input class=\"ag-plansteps\" type=\"number\" min=\"1\" value=\"20\"></label>\n            <button class=\"ag-mind-btn\" data-act=\"set-plansteps\"\n              title=\"set MAX_PLAN_STEPS - the convergence guard: how many autonomous steps one accepted plan item may take before it needs human re-approval\">set</button>\n            <label clas