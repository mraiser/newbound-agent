-drop reorder ── the dragged id is shared between the\n  // per-row handlers (wired in renderSessions) and these container handlers,\n  // which are attached ONCE so re-renders never stack listeners.\n  let dragSid = null;\n  const clearDropMarks = () => {\n    for (const el of sessListEl.querySelectorAll(\".ag-drop-above\")) el.classList.remove(\"ag-drop-above\");\n  };\n  const sessOrderIds = () => Array.from(sessListEl.querySelectorAll(\".ag-sess\")).map((el) => el.dataset.sid);\n  async function applySessOrder(ids) {\n    await invokeP(\"agent\", \"chat\", \"session_index\", { op: \"reorder\", id: \"\", arg: JSON.stringify(ids) });\n    await renderSessions();\n  }\n  // dropping in the empty space below the rows moves the session to the END\n  sessListEl.addEventListener(\"dragover\", (ev) => {\n    if (!dragSid) return;\n    ev.preventDefault();\n    ev.dataTransfer.dropEffect = \"move\";\n  });\n  sessListEl.addEventListener(\"drop\", async (ev) => {\n    if (!dragSid) return;\n    ev.preventDefault();\n    if (ev.target.closest && ev.target.closest(\".ag-sess\")) return; // row drops are handled on the row\n    const ids = sessOrderIds().filter((i) => i !== dragSid);\n    ids.push(dragSid);\n    clearDropMarks();\n    await applySessOrder(ids);\n  });\n  async function renderSessions() {","old":"  const sessListEl = host.querySelector(\".ag-sess-list\");\n  async function renderSessions() {","patch_id":"p180","time":1793018723923},{"author":"agent","facet":"js","label":"session reorder: per-row drag handlers","new":"      const row = document.createElement(\"div\");\n      row.className = \"ag-sess\" + (s.id === sessId ? \" on\" : \"\");\n      row.dataset.sid = s.id;\n      row.draggable = true;\n      row.addEventListener(\"dragstart\", (ev) => {\n        if (row.querySelector(\".ag-sess-edit\")) { ev.preventDefault(); return; } // renaming — don't drag\n        dragSid = s.id;\n        row.classList.add(\"dragging\");\n        ev.dataTransfer.setData(\"text/plain\", s.id);\n        ev.dataTransfer.effectAllowed = \"move\";\n      });\n      row.addEventListener(\"dragover\", (ev) => {\n        if (!dragSid) return;\n        ev.preventDefault();\n        ev.dataTransfer.dropEffect = \"move\";\n        clearDropMarks();\n        if (s.id !== dragSid) row.classList.add(\"ag-drop-above\"); // insert-above indicator\n      });\n      row.addEventListener(\"dragleave\", () => row.classList.remove(\"ag-drop-above\"));\n      row.addEventListener(\"drop\", async (ev) => {\n        ev.preventDefault();\n        ev.stopPropagation();\n        clearDropMarks();\n        if (!dragSid || dragSid === s.id) return; // drop on itself = no-op\n        const ids = sessOrderIds().filter((i) => i !== dragSid);\n        ids.splice(ids.indexOf(s.id), 0, dragSid); // insert ABOVE the target row\n        await applySessOrder(ids);\n      });\n      row.addEventListener(\"dragend\", () => {\n        dragSid = null;\n        row.classList.remove(\"dragging\");\n        clearDropMarks();\n      });\n      const open = document.createElement(\"button\");","old":"      const row = document.createElement(\"div\");\n      row.className = \"ag-sess\" + (s.id === sessId ? \" on\" : \"\");\n      const open = document.createElement(\"button\");","patch_id":"p181","time":1793018733862},{"author":"agent","facet":"css","label":"session reorder: drop indicator + dragging styles","new":".ag-sess-del:hover { color: var(--bad, #c0564f); }\n.ag-sess.ag-drop-above { box-shadow: inset 0 2px 0 var(--accent, #f0a63c); }\n.ag-sess.dragging { opacity: 0.5; }","old":".ag-sess-del:hover { color: var(--bad, #c0564f); }","patch_id":"p182","time":1793018741527},{"author":"agent","facet":"js","label":"chat copy: shared copyText helper (clipboard + hidden-textarea fallback)","new":"  // one clipboard write for every copy affordance: navigator.clipboard only\n  // exists on https/localhost, so on any throw fall back to the hidden\n  // textarea — covers plain http from another machine on the LAN.\n  async function copyText(txt) {\n    try { await navigator.clipboard.writeText(txt); return true; } catch (e) {}\n    let ok = false;\n    const ta = document.createElement(\"textarea\");\n    ta.value = txt;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  function cellEl(entry) {","old":"  function cellEl(entry) {","patch_id":"p183","time":1793018930956},{"author":"agent","facet":"js","label":"chat copy: copy button under user messages too","new":"    // + copy on user and agent messages. Tool/stage/snap/busy cells get nothing.\n    const wantCopy = entry.kind === \"agent\" || entry.kind === \"user\";","old":"    // + copy-markdown on agent replies. Tool/stage/snap/busy cells get nothing.\n    const wantCopy = entry.kind === \"agent\";","patch_id":"p184","time":1793018936733},{"author":"agent","facet":"js","label":"chat copy: meta-row copy routes through copyText","new":"        cp.onclick = async () => {\n          const ok = await copyText(entry.text ?? \"\");\n          cp.textContent = ok ? \"✓ copied\" : \"copy failed\";\n          setTimeout(() => { cp.textContent = \"copy\"; }, 1500);\n        };","old":"        cp.onclick = async () => {\n          const txt = entry.text ?? \"\";\n          let ok = false;\n          try { await navigator.clipboard.writeText(txt); ok = true; } catch (e) {}\n          if (!ok) {\n            // navigator.clipboard needs https/localhost — hidden-textarea\n            // fallback covers plain http from another machine on the LAN\n            const ta = document.createElement(\"textarea\");\n            ta.value = txt;\n            ta.style.position = \"fixed\";\n            ta.style.opacity = \"0\";\n            document.body.appendChild(ta);\n            ta.select();\n            try { ok = document.execCommand(\"copy\"); } catch (e) {}\n            ta.remove();\n          }\n          cp.textContent = ok ? \"✓ copied\" : \"copy failed\";\n          setTimeout(() => { cp.textContent = \"copy\"; }, 1500);\n        };","patch_id":"p185","time":1793018944569},{"author":"agent","facet":"js","label":"chat: hover copy button on every code block in user/agent cells","new":"      div.appendChild(meta);\n    }\n    // per-code-block copy: each fenced block in a user/agent cell gets its\n    // own hover button (top-right). The button lives in a wrapper, never\n    // inside the pre, so pre.textContent stays exactly the code. Tool cells\n    // are excluded — their clipped-expansion path re-renders its own body.\n    if (entry.kind === \"user\" || entry.kind === \"agent\") {\n      body.querySelectorAll(\"pre\").forEach((pre) => {\n        const wrap = document.createElement(\"div\");\n        wrap.className = \"ag-code-wrap\";\n        pre.replaceWith(wrap);\n        wrap.appendChild(pre);\n        const btn = document.createElement(\"button\");\n        btn.type = \"button\";\n        btn.className = \"ag-code-copy\";\n        btn.textContent = \"copy\";\n        btn.title = \"copy this code block\";\n        btn.onclick = async () => {\n          const ok = await copyText(pre.textContent);\n          btn.textContent = ok ? \"✓\" : \"✗\";\n          setTimeout(() => { btn.textContent = \"copy\"; }, 1500);\n        };\n        wrap.appendChild(btn);\n      });\n    }\n    if (entry.kind === \"stage\") {","old":"      div.appendChild(meta);\n    }\n    if (entry.kind === \"stage\") {","patch_id":"p186","time":1793019090780},{"author":"agent","facet":"css","label":"chat: hover styles for per-code-block copy button","new":".ag-cell-body pre { background: var(--panel); border: 1px solid var(--line);\n  border-radius: 8px; padding: 8px; overflow-x: auto; font-size: 12px; }\n/* per-code-block copy: the wrapper hosts the button so the pre's textContent\n   stays exactly the code; hover reveals it. `.ag-cell-body pre` still matches\n   through the wrapper, so block styling is untouched. */\n.ag-code-wrap { position: relative; }\n.ag-app .ag-code-copy { position: absolute; top: 4px; right: 4px; padding: 1px 7px;\n  font-size: 11px; background: var(--panel); border: 1px solid var(--line);\n  border-radius: 6px; color: var(--text-faint); cursor: pointer;\n  opacity: 0; transition: opacity .12s; }\n.ag-code-wrap:hover .ag-code-copy { opacity: 1; }\n.ag-app .ag-code-copy:hover { color: var(--accent, #f0a63c); }","old":".ag-cell-body pre { background: var(--panel); border: 1px solid var(--line);\n  border-radius: 8px; padding: 8px; overflow-x: auto; font-size: 12px; }","patch_id":"p187","time":1793019108246},{"author":"alex89romanov","facet":"js","label":"rename: stamp customTitle before server call, persist on success, roll back on failure","new":"            if (t && t !== s.title) {\n              // open session: stamp the title locally BEFORE the server call —\n              // a persist() racing in from a reply in progress must already\n              // carry it, or a reload loses the rename. Roll back on failure;\n              // on success persist() rewrites the record with custom_title.\n              const mine = s.id === sessId;\n              const prev = customTitle;\n              if (mine) customTitle = t;\n              const rr = await invokeP(\"agent\", \"chat\", \"session_index\", { op: \"rename\", id: s.id, arg: t });\n              if (rr && rr.status === \"ok\") { if (mine) persist(); }\n              else if (mine) customTitle = prev;\n            }","old":"            if (t && t !== s.title) {\n              const rr = await invokeP(\"agent\", \"chat\", \"session_index\", { op: \"rename\", id: s.id, arg: t });\n              if (rr && rr.status === \"ok\" && s.id === sessId) customTitle = t;\n            }","patch_id":"p188","time":1793099966158},{"author":"alex89romanov","facet":"js","label":"copy: prefer entry.typed on user cells; tooltip per kind","new":"        cp.title = entry.kind === \"user\" ? \"copy this message\"\n          : \"copy this reply's Markdown\";\n        cp.onclick = async () => {\n          // user cells: entry.typed is what was actually typed, without the\n          // [ATTACHED FILES] block; older entries fall back to the full text.\n          const ok = await copyText(entry.typed ?? entry.text ?? \"\");","old":"        cp.title = \"copy this reply's Markdown\";\n        cp.onclick = async () => {\n          const ok = await copyText(entry.text ?? \"\");","patch_id":"p189","time":1793099972970},{"author":"alex89romanov","facet":"js","label":"send: capture what the user typed before the attach block is appended","new":"    let message = input.value.trim();\n    const typed = message;  // before the [ATTACHED FILES] block — copy uses this\n    if ((!message && !attachments.length) || sendBtn.disabled) return;","old":"    let message = input.value.trim();\n    if ((!message && !attachments.length) || sendBtn.disabled) return;","patch_id":"p190","time":1793099978957},{"author":"alex89romanov","facet":"js","label":"send: store entry.typed on the user cell","new":"    pushCell({ kind: \"user\", text: message, typed });","old":"    pushCell({ kind: \"user\", text: message });","patch_id":"p191","time":1793099984153},{"author":"alex89romanov","facet":"js","label":"sidebar width: safe localStorage + drag limits applied on restore","new":"  const SESSW_KEY = \"agent.chat.sessw\";\n  // blocked storage throws on any touch — a throw during init would kill the\n  // rest of the chat setup, so every localStorage access goes through these.\n  const lsGet = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };\n  const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch (e) {} };\n  const lsDel = (k) => { try { localStorage.removeItem(k); } catch (e) {} };\n  // restore through the same limits the drag enforces (min 140px, max half\n  // the window) — a width saved on a big monitor must fit a laptop.\n  const clampSessW = () => {\n    const savedW = parseInt(lsGet(SESSW_KEY), 10);\n    if (savedW) sessAside.style.width =\n      Math.min(Math.max(140, savedW), Math.floor(window.innerWidth / 2)) + \"px\";\n  };\n  clampSessW();","old":"  const SESSW_KEY = \"agent.chat.sessw\";\n  const savedW = parseInt(localStorage.getItem(SESSW_KEY), 10);\n  if (savedW) sessAside.style.width = savedW + \"px\";","patch_id":"p192","time":1793099993094},{"author":"alex89romanov","facet":"js","label":"sidebar divider: pointercancel ends the drag; safe storage writes","new":"    const up = () => {\n      sdiv.classList.remove(\"drag\");\n      sdiv.removeEventListener(\"pointermove\", move);\n      sdiv.removeEventListener(\"pointerup\", up);\n      sdiv.removeEventListener(\"pointercancel\", up);\n      lsSet(SESSW_KEY,\n        String(Math.round(sessAside.getBoundingClientRect().width)));\n    };\n    sdiv.addEventListener(\"pointermove\", move);\n    sdiv.addEventListener(\"pointerup\", up);\n    sdiv.addEventListener(\"pointercancel\", up); // a cancelled drag must not stick\n  });\n  sdiv.addEventListener(\"dblclick\", () => {\n    lsDel(SESSW_KEY);","old":"    const up = () => {\n      sdiv.classList.remove(\"drag\");\n      sdiv.removeEventListener(\"pointermove\", move);\n      sdiv.removeEventListener(\"pointerup\", up);\n      localStorage.setItem(SESSW_KEY,\n        String(Math.round(sessAside.getBoundingClientRect().width)));\n    };\n    sdiv.addEventListener(\"pointermove\", move);\n    sdiv.addEventListener(\"pointerup\", up);\n  });\n  sdiv.addEventListener(\"dblclick\", () => {\n    localStorage.removeItem(SESSW_KEY);","patch_id":"p193","time":1793100001243},{"author":"alex89romanov","facet":"js","label":"input height: drag limits applied on restore (thread keeps 120px)","new":"  const INPUTH_KEY = \"agent.chat.inputh\";\n  // same limits as the drag: input never under 52px, thread keeps >= 120px.\n  const clampInputH = () => {\n    const savedH = parseInt(lsGet(INPUTH_KEY), 10);\n    if (!savedH) return;\n    const room = askInput.getBoundingClientRect().height\n      + thread.getBoundingClientRect().height - 120;\n    askInput.style.height = Math.max(52, Math.min(savedH, room)) + \"px\";\n  };\n  clampInputH();","old":"  const INPUTH_KEY = \"agent.chat.inputh\";\n  const savedH = parseInt(localStorage.getItem(INPUTH_KEY), 10);\n  if (savedH) askInput.style.height = savedH + \"px\";","patch_id":"p194","time":1793100008637},{"author":"alex89romanov","facet":"js","label":"input divider: pointercancel; re-clamp both saved sizes on window resize","new":"    const up = () => {\n      adiv.classList.remove(\"drag\");\n      adiv.removeEventListener(\"pointermove\", move);\n      adiv.removeEventListener(\"pointerup\", up);\n      adiv.removeEventListener(\"pointercancel\", up);\n      lsSet(INPUTH_KEY,\n        String(Math.round(askInput.getBoundingClientRect().height)));\n    };\n    adiv.addEventListener(\"pointermove\", move);\n    adiv.addEventListener(\"pointerup\", up);\n    adiv.addEventListener(\"pointercancel\", up); // a cancelled drag must not stick\n  });\n  adiv.addEventListener(\"dblclick\", () => {\n    lsDel(INPUTH_KEY);\n    askInput.style.removeProperty(\"height\");\n  });\n  // a shrinking window re-applies both saved sizes through their limits, so\n  // a tall box or wide sidebar from a big monitor never squeezes the thread.\n  const onWinResize = () => { clampSessW(); clampInputH(); };\n  window.addEventListener(\"resize\", onWinResize);","old":"    const up = () => {\n      adiv.classList.remove(\"drag\");\n      adiv.removeEventListener(\"pointermove\", move);\n      adiv.removeEventListener(\"pointerup\", up);\n      localStorage.setItem(INPUTH_KEY,\n        String(Math.round(askInput.getBoundingClientRect().height)));\n    };\n    adiv.addEventListener(\"pointermove\", move);\n    adiv.addEventListener(\"pointerup\", up);\n  });\n  adiv.addEventListener(\"dblclick\", () => {\n    localStorage.removeItem(INPUTH_KEY);\n    askInput.style.removeProperty(\"height\");\n  });","patch_id":"p195","time":1793100018680},{"author":"alex89romanov","facet":"js","label":"dispose: detach the window resize clamp","new":"  return { dispose() { window.removeEventListener(\"resize\", onWinResize); } };","old":"  return { dispose() { /* nothing persistent beyond localStorage */ } };","patch_id":"p196","time":1793100023837},{"author":"alex89romanov","facet":"css","label":"rename pencil: keyboard reachable (opacity + :focus-visible)","new":"/* opacity, not visibility: the pencil stays in the Tab order */\n.ag-app .ag-sess-ren { flex: none; background: none; border: none; padding: 0 2px; color: var(--text-faint); cursor: pointer; opacity: 0; }\n.ag-sess:hover .ag-sess-ren, .ag-sess.on .ag-sess-ren, .ag-app .ag-sess-ren:focus-visible { opacity: 1; }","old":".ag-app .ag-sess-ren { flex: none; background: none; border: none; padding: 0 2px; color: var(--text-faint); cursor: pointer; visibility: hidden; }\n.ag-sess:hover .ag-sess-ren, .ag-sess.on .ag-sess-ren { visibility: visible; }","patch_id":"p197","time":1793100031728},{"author":"alex89romanov","facet":"js","label":"input clamp: skip when the chat pane is hidden (measures 0)","new":"    const room = askInput.getBoundingClientRect().height\n      + thread.getBoundingClientRect().height - 120;\n    if (room <= 0) return; // a hidden pane measures 0 — don't clamp on a resize there\n    askInput.style.height = Math.max(52, Math.min(savedH, room)) + \"px\";","old":"    const room = askInput.getBoundingClientRect().height\n      + thread.getBoundingClientRect().height - 120;\n    askInput.style.height = Math.max(52, Math.min(savedH, room)) + \"px\";","patch_id":"p198","time":1793100115996},{"author":"alex89romanov","facet":"html","label":"mind tab: replace the nine-card grid with the sectioned workspace (sidebar, panes, footer, six templates)","new":"    <section class=\"ag-pane\" data-pane=\"mind\" hidden>\n      <div class=\"mx\">\n        <div class=\"mx-heading\">\n          <div>\n            <h2>Mind</h2>\n            <p>Choose how your agent responds, works, and learns. Live status refreshes every 5 seconds.</p>\n          </div>\n          <label class=\"mx-keys\">Show config keys\n            <span class=\"tg\"><input type=\"checkbox\" class=\"mx-showkeys\" aria-label=\"Show config keys\"><span></span></span>\n          </label>\n        </div>\n        <div class=\"mx-work\">\n          <nav class=\"mx-side\" aria-label=\"Mind sections\"></nav>\n          <div class=\"mx-content\">\n            <div class=\"mx-panes\"></div>\n            <section class=\"mx-review\" hidden></section>\n          </div>\n        </div>\n        <footer class=\"mx-foot\">\n          <span><span class=\"state mx-dirty\">No pending changes</span> <span class=\"toast mx-toast\" hidden></span></span>\n          <span class=\"btnrow\">\n            <button class=\"mx-discard\" disabled>Discard</button>\n            <button class=\"mx-reviewbtn primary\" disabled>Review changes</button>\n          </span>\n        </footer>\n      </div>\n\n      <template data-mt=\"conversation\">\n        <div class=\"mx-split\"><div>\n          <div class=\"mx-status\" data-status=\"conversation\"></div>\n\n          <label class=\"fld\"><span>Chat provider <span class=\"k\">LLM</span></span>\n            <select data-key=\"LLM\" data-provider>\n              <option value=\"CLAUDECODE\">Claude Code (CLI)</option>\n              <option value=\"ANTHROPIC\">Anthropic API</option>\n              <option value=\"OPENAI\">OpenAI (or compatible)</option>\n              <option value=\"GEMINI\">Gemini</option>\n              <option value=\"VLLM\">vLLM server</option>\n              <option value=\"OLLAMA\">Ollama</option>\n              <option value=\"LOCAL\">Trained local model</option>\n              <option value=\"REMOTE\">Another Newbound peer</option>\n              <option value=\"CUSTOM\">Custom command</option>\n            </select>\n            <small>Answers you in chat and handles the agent's other frontier-model calls.</small>\n          </label>\n\n          <div data-when=\"VLLM\">\n            <label class=\"fld\"><span>Server address <span class=\"k\">VLLM_URL</span></span><input class=\"mono\" data-key=\"VLLM_URL\" data-req placeholder=\"http://localhost:8000/v1/chat/completions\"><small>The chat-completions endpoint of your server.</small></label>\n            <label class=\"fld\"><span>Model name <span class=\"k\">VLLM_MODEL</span></span><input data-key=\"VLLM_MODEL\" data-req placeholder=\"the model your server serves\"></label>\n          </div>\n          <div data-when=\"OPENAI\">\n            <label class=\"fld\"><span>Model <span class=\"k\">OPENAI_MODEL</span></span><input data-key=\"OPENAI_MODEL\" data-req placeholder=\"e.g. gpt-5\"></label>\n            <label class=\"fld\"><span>Custom endpoint (optional) <span class=\"k\">OPENAI_URL</span></span><input class=\"mono\" data-key=\"OPENAI_URL\" placeholder=\"blank = api.openai.com\"><small>For OpenAI-compatible servers. A custom endpoint may not need a key.</small></label>\n          </div>\n          <div data-when=\"ANTHROPIC\">\n            <label class=\"fld\"><span>Model <span class=\"k\">ANTHROPIC_MODEL</span></span><input data-key=\"ANTHROPIC_MODEL\" data-req placeholder=\"e.g. claude-opus-5-5\"></label>\n            <label class=\"fld\"><span>Endpoint (optional) <span class=\"k\">ANTHROPIC_URL</span></span><input class=\"mono\" data-key=\"ANTHROPIC_URL\" placeholder=\"https://api.anthropic.com/v1/messages\"></label>\n          </div>\n          <div data-when=\"GEMINI\">\n            <label class=\"fld\"><span>Model <span class=\"k\">GEMINI_MODEL</span></span><input data-key=\"GEMINI_MODEL\" data-req placeholder=\"e.g. gemini-2.5-pro\"></label>\n            <label class=\"fld\"><span>Endpoint (optional) <span class=\"k\">GEMINI_URL</span></span><input class=\"mono\" data-key=\"GEMINI_URL\" placeholder=\"blank = Google's default\"></label>\n          </div>\n          <div data-when=\"OLLAMA\">\n            <label class=\"fld\"><span>Server address <span class=\"k\">OLLAMA_URL</span></span><input class=\"mono\" data-key=\"OLLAMA_URL\" placeholder=\"http://127.0.0.1:11434/api/chat\"></label>\n            <label class=\"fld\"><span>Model <span class=\"k\">OLLAMA_MODEL</span></span><input data-key=\"OLLAMA_MODEL\" data-req placeholder=\"e.g. qwen3:32b\"></label>\n          </div>\n          <div data-when=\"CLAUDECODE\">\n            <label class=\"fld\"><span>Model <span class=\"k\">CLAUDE_CODE_MODEL</span></span><input data-key=\"CLAUDE_CODE_MODEL\" placeholder=\"blank = the CLI's default\"><small>Uses the installed Claude Code CLI with its own tools and permissions.</small></label>\n            <details class=\"more\"><summary>Claude Code options</summary>\n              <div class=\"row2\">\n                <label class=\"fld\"><span>Permission mode <span class=\"k\">CLAUDE_CODE_PERMISSION_MODE</span></span>\n                  <select data-key=\"CLAUDE_CODE_PERMISSION_MODE\"><option value=\"\">CLI default</option><option>default</option><option>acceptEdits</option><option>plan</option><option>bypassPermissions</option></select></label>\n                <label class=\"fld\"><span>System prompt <span class=\"k\">CLAUDE_CODE_SYSTEM_MODE</span></span>\n                  <select data-key=\"CLAUDE_CODE_SYSTEM_MODE\"><option value=\"replace\">Replace the CLI's prompt</option><option value=\"append\">Append to the CLI's prompt</option></select></label>\n                <label class=\"fld\"><span>Timeout, seconds <span class=\"k\">CLAUDE_CODE_TIMEOUT</span></span><input data-key=\"CLAUDE_CODE_TIMEOUT\" type=\"number\" min=\"1\"></label>\n                <label class=\"fld\"><span>Idle timeout, seconds <span class=\"k\">CLAUDE_CODE_IDLE_TIMEOUT</span></span><input data-key=\"CLAUDE_CODE_IDLE_TIMEOUT\" type=\"number\" min=\"1\"></label>\n              </div>\n              <label class=\"fld\"><span>Allowed tools <span class=\"k\">CLAUDE_CODE_TOOLS</span></span><input data-key=\"CLAUDE_CODE_TOOLS\" placeholder=\"blank = CLI default\"></label>\n              <label class=\"fld\"><span>MCP servers (JSON, one line) <span class=\"k\">CLAUDE_CODE_MCP</span></span><textarea class=\"mono\" rows=\"3\" data-key=\"CLAUDE_CODE_MCP\"></textarea></label>\n              <div class=\"row2\">\n                <label class=\"fld\"><span>Working folder <span class=\"k\">CLAUDE_CODE_CWD</span></span><input class=\"mono\" data-key=\"CLAUDE_CODE_CWD\"></label>\n                <label class=\"fld\"><span>CLI path <span class=\"k\">CLAUDE_CODE_BIN</span></span><input class=\"mono\" data-key=\"CLAUDE_CODE_BIN\"></label>\n              </div>\n            </details>\n          </div>\n          <div data-when=\"LOCAL\"><div class=\"note warn\">Answers from the version released to chat under <b>Local learning → Release to chat</b>. Text only: the local model can't use tools, so chat becomes plain answers. The service refuses until a version has been released.</div></div>\n          <div data-when=\"REMOTE\">\n            <label class=\"fld\"><span>Peer <span class=\"k\">LLM_REMOTE</span></span><input class=\"mono\" data-key=\"LLM_REMOTE\" data-req placeholder=\"the peer's id\"><small>That peer answers with its own provider setting.</small></label>\n            <div class=\"row2\">\n              <label class=\"fld\"><span>Remote command id (optional) <span class=\"k\">LLM_REMOTE_ID</span></span><input class=\"mono\" data-key=\"LLM_REMOTE_ID\" placeholder=\"blank = same as this peer\"></label>\n              <label class=\"fld\"><span>Split large requests <span class=\"k\">LLM_REMOTE_SPLIT</span></span><select data-key=\"LLM_REMOTE_SPLIT\"><option value=\"\">off</option><option value=\"on\">on</option></select></label>\n            </div>\n          </div>\n          <div data-when=\"CUSTOM\">\n            <label class=\"fld\"><span>Command <span class=\"k\">LLM_CTL</span></span><input class=\"mono\" data-key=\"LLM_CTL\" data-req placeholder=\"lib:ctl:cmd\"><small>Any command taking (messages, tools) or (prompt, system_prompt).</small></label>\n          </div>\n          <div class=\"note\" data-keynote></div>\n          <div class=\"note err\" data-provider-err></div>\n          <div class=\"timing\">Changes apply to the next model call.</div>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">a useful distinction</span>\n          <h4>Chat and learning are separate.</h4>\n          <p>You can use an external chat model while a local service learns in the background.</p>\n          <p>Changing this provider does not start training or change your local checkpoint.</p>\n          <hr>\n          <p>What your agent knows and how it is instructed still live in <b>Memory</b> and <b>Prompts</b>.</p>\n        </aside></div>\n      </template>\n\n      <template data-mt=\"activity\">\n        <div class=\"mx-split\"><div>\n          <div class=\"mx-status\" data-status=\"activity\"></div>\n\n          <div class=\"sw\"><div><strong>Observe background events</strong><span class=\"now\">applies now</span><p>Let sensors collect events for the agent to consider.</p><span class=\"k\">agent.sensor.start / stop</span></div>\n            <span class=\"tg\"><input type=\"checkbox\" data-live=\"sensor\" aria-label=\"Observe background events\"><span></span></span></div>\n          <div class=\"sw\"><div><strong>Think in the background</strong><span class=\"now\">applies now</span><p>Let the executive weigh events and do its own memory upkeep.</p><span class=\"k\">agent.executive.start / stop</span></div>\n            <span class=\"tg\"><input type=\"checkbox\" data-live=\"executive\" aria-label=\"Think in the background\"><span></span></span></div>\n          <label class=\"fld\"><span>Self-initiated activity <span class=\"k\">agent.executive.set_drive</span></span>\n            <span class=\"inline\"><input type=\"number\" min=\"0\" step=\"1\" data-key=\"@drive\"> memory acts per hour</span>\n            <small>Idle memory upkeep: reverify, connect, wonder, distill. Plan items don't use it; they have their own worker below.</small></label>\n          <div class=\"note\" data-activity-note></div>\n          <div class=\"res\" data-res=\"loop\"></div>\n\n          <div class=\"mx-block\">\n            <span class=\"lbl\">plan items</span>\n            <div class=\"mx-status\" data-status=\"plan\"></div>\n            <div class=\"sw\"><div><strong>Work on accepted plan items by itself</strong><span class=\"now\">applies now</span><p>The plan worker steps accepted and in-progress items back to back on its own thread, and goes quiet (no model calls) when none are ready. Stays on across restarts.</p><span class=\"k\">PLAN_AUTONOMY · agent.plan.worker_start</span></div>\n              <span class=\"tg\"><input type=\"checkbox\" data-live=\"plan\" aria-label=\"Plan autonomy\"><span></span></span></div>\n            <div class=\"row2\">\n              <label class=\"fld\"><span>Steps per item before re-approval <span class=\"k\">MAX_PLAN_STEPS</span></span><input type=\"number\" min=\"1\" data-key=\"MAX_PLAN_STEPS\"><small>The convergence guard: after this many steps an item waits for you.</small></label>\n              <label class=\"fld\"><span>Plan steps per hour <span class=\"k\">PLAN_STEPS_PER_HOUR</span></span><input type=\"number\" min=\"0\" data-key=\"PLAN_STEPS_PER_HOUR\" placeholder=\"0\"><small>A sliding-hour cap on the worker's reasoning turns. 0 = no cap (the default).</small></label>\n            </div>\n            <div class=\"res\" data-res=\"plan\"></div>\n          </div>\n\n          <div class=\"mx-block\">\n            <span class=\"lbl\">automatic commits — model-written commit messages</span>\n            <p class=\"para\">The diff is the source of truth: one model-written message per changed store unit, then commit and push. If the model is down, a fallback message is used. Turning a repo on here turns dev's mechanical autocommit off for it, so the agent drives it.</p>\n            <div data-repos></div>\n            <div class=\"btnrow\" style=\"margin-top:12px\">\n              <button data-act=\"sweep\" title=\"run the agent-committer's sweep now - group dirty store units, compose a message each, commit, push\">Commit now</button>\n              <span class=\"lbl\" data-repocount></span>\n            </div>\n            <div class=\"res\" data-res=\"committer\"></div>\n          </div>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">what this means</span>\n          <h4>You control the initiative.</h4>\n          <p>Observation and thinking are independent. You can collect events while keeping the executive paused.</p>\n          <p>Background activity can make model calls. Its rate is not a spending limit or a tool permission setting.</p>\n          <hr>\n          <p>Switches marked <b>applies now</b> start or stop something immediately. Rates and limits wait in your draft until you review them.</p>\n        </aside></div>\n      </template>\n\n      <template data-mt=\"learning\">\n        <div class=\"mx-split\"><div>\n          <div class=\"mx-status\" data-status=\"learning\"></div>\n\n          <div class=\"sw\"><div><strong>Score what matters locally</strong><p>Use the resident model to score incoming events for importance.</p><span class=\"k\">SALIENCE</span></div>\n            <span class=\"tg\"><input type=\"checkbox\" data-key=\"SALIENCE\" data-on=\"on\" data-off=\"off\" aria-label=\"Score what matters locally\"><span></span></span></div>\n          <div class=\"sw\"><div><strong>Train the resident model</strong><p>Let the service's training loop run while it is up.</p><span class=\"k\">MODEL_TRAIN</span></div>\n            <span class=\"tg\"><input type=\"checkbox\" data-key=\"MODEL_TRAIN\" data-on=\"on\" data-off=\"off\" aria-label=\"Train the resident model\"><span></span></span></div>\n          <label class=\"fld\"><span>Release learned updates to local chat <span class=\"k\">USER_GATE · mode</span></span>\n            <select data-virtual=\"gateMode\"><option value=\"manual\">After evaluation, ask me to approve</option><option value=\"auto\">After evaluation, release automatically</option></select>\n            <small>Only affects the trained local chat model. An external provider is separate. The gate's other numbers are in Advanced.</small></label>\n          <div class=\"timing\">Scoring applies immediately. Training and release policy apply after the service restarts.</div>\n\n          <div class=\"mx-block\">\n            <span class=\"lbl\">service</span>\n            <div class=\"btnrow\">\n              <button data-act=\"bootstrap\" title=\"idempotent oneshot: install env if configured, train if the checkpoint dir is empty, write scripts, launch/converge the service\">Start / repair service</button>\n              <button data-act=\"promote\" title=\"load the newest ring checkpoint into the inactive slot and swap the live pointer\">Load newest checkpoint</button>\n              <button data-act=\"release\" title=\"stop the service and free ALL of the agent's GPU memory; ring checkpoints, replay, and metrics survive - resume with bootstrap (loads the newest ring checkpoint). set SALIENCE=off too if you want it to stay off across executive restarts\">Release GPU</button>\n            </div>\n            <p class=\"para\" style=\"margin-top:8px\">Release GPU keeps checkpoints, replay and metrics; Start brings it back on the newest checkpoint. Turn scoring off too if it should stay off across executive restarts.</p>\n            <div class=\"res\" data-res=\"judge\"></div>\n          </div>\n\n          <div class=\"mx-block\" data-forge hidden>\n            <span class=\"lbl\">base training</span>\n            <div data-forge-body></div>\n          </div>\n\n          <div class=\"mx-block\">\n            <span class=\"lbl\">release to chat — the user-facing version</span>\n            <div data-userptr></div>\n            <div class=\"btnrow\" style=\"margin-top:10px\">\n              <button data-act=\"user-promote\" hidden title=\"advance the user-facing pointer onto the gate's ready candidate - the deliberate approval the manual mode waits for\">Approve update</button>\n              <button data-act=\"user-rollback\" hidden title=\"revert the user-facing pointer to last_good (one step; the watchdog does this automatically on agreement decay)\">Roll back</button>\n            </div>\n          </div>\n\n          <div class=\"mx-block\">\n            <span class=\"lbl\">continuous training</span>\n            <div data-flywheel></div>\n            <div class=\"btnrow\" style=\"margin-top:12px\"><button data-act=\"export\" title=\"write the accumulated feedstock (salience pairs, claims, curation traces) as a JSONL batch into the trainer's ingest directory\">Send new material to training</button></div>\n            <div class=\"res\" data-res=\"flywheel\"></div>\n          </div>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">two different updates</span>\n          <h4>Learning isn't a release.</h4>\n          <p>A model can keep training without changing the version that answers you.</p>\n          <p>The local chat version has its own evaluation and release gate.</p>\n          <hr>\n          <p>Training charts and the salience audit trail live in <b>Insights</b>; they read the agent's own logs, so they stay visible when the service is down.</p>\n        </aside></div>\n      </template>\n\n      <template data-mt=\"personality\">\n        <div class=\"mx-split\"><div>\n          <div class=\"mx-status\" data-status=\"personality\"></div>\n          <div class=\"note\">Applies to the local personality adapter. To guide an external chat provider, use the <b>Prompts</b> tab.</div>\n          <p class=\"para\">One exchange per row. Every 5th row is held out for the check and never trained on. Saved examples are picked up at the service's next gate tick, and a big rewrite can slip the check and trigger re-derivation on its own.</p>\n          <div class=\"pstate\" data-pstate></div>\n          <div class=\"persona-list\" data-persona></div>\n          <div class=\"btnrow\" style=\"margin-top:6px\">\n            <button data-act=\"persona-add\">+ Add exchange</button>\n            <button data-act=\"persona-reload\" title=\"discard unsaved edits and reload from disk (or the default seed when nothing is saved)\">Reload from disk</button>\n            <span style=\"flex:1\"></span>\n            <button data-act=\"rederive\" hidden title=\"re-derive the personality adapter from persona/persona.jsonl against the user pointer's current base - blocks through the LoRA run; the derivation gate can reject it (serving stays untouched). the probe triggers this automatically when the skin slips\">Re-derive personality now</button>\n          </div>\n          <div class=\"res\" data-res=\"persona\"></div>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">show, then refine</span>\n          <h4>Examples teach a voice.</h4>\n          <p>Use realistic exchanges to demonstrate tone, structure, and level of detail.</p>\n          <p>Re-deriving runs a short training pass against the version released to chat. Its own gate can reject the result; chat keeps working either way.</p>\n          <hr>\n          <p>Edits join your draft and are saved together with your other changes. Empty rows are skipped; a bad raw row blocks saving.</p>\n        </aside></div>\n      </template>\n\n      <template data-mt=\"insights\">\n        <div class=\"mx-split\"><div>\n          <span class=\"lbl\" style=\"display:block;margin-bottom:8px\">the harvest — what the week grew</span>\n          <div class=\"mx-status\" data-status=\"harvest\"></div>\n          <span class=\"lbl\" style=\"display:block;margin:4px 0 8px\">statistics — the salience audit trail</span>\n          <div class=\"mx-status\" data-status=\"stats\"></div>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">read-only</span>\n          <h4>What the agent is learning.</h4>\n          <p>The harvest counts the week's new memory claims, the executive's upkeep acts, and the questions it is wondering about.</p>\n          <p>Notions waiting for audit are reviewed in <b>Memory</b>.</p>\n          <hr>\n          <p>Statistics compare the local judge's scores with the frontier model's. Rising disagreement is the signal to look closer.</p>\n        </aside></div>\n      </template>\n\n      <template data-mt=\"advanced\">\n        <div class=\"mx-split\"><div>\n          <div class=\"row2\">\n            <label class=\"fld\"><span>Resident model checkpoint <span class=\"k\">MODEL_CHECKPOINT</span></span><input class=\"mono\" data-key=\"MODEL_CHECKPOINT\"><small>\"stub\" for service testing, or a checkpoint path.</small></label>\n            <label class=\"fld\"><span>Local service port <span class=\"k\">MODEL_SERVICE_PORT</span></span><input type=\"number\" min=\"1\" max=\"65535\" data-key=\"MODEL_SERVICE_PORT\"></label>\n          </div>\n          <div class=\"timing\">Both apply after the service restarts.</div>\n\n          <details class=\"more\" style=\"margin-top:14px\"><summary>Training parameters</summary>\n            <div class=\"row2\">\n              <label class=\"fld\"><span>Learning rate <span class=\"k\">MODEL_TRAIN_LR</span></span><input class=\"mono\" data-key=\"MODEL_TRAIN_LR\"></label>\n              <label class=\"fld\"><span>Training interval <span class=\"k\">MODEL_TRAIN_INTERVAL</span></span><input class=\"mono\" data-key=\"MODEL_TRAIN_INTERVAL\"></label>\n            </div>\n            <label class=\"fld\"><span>Training mix <span class=\"k\">MODEL_MIX</span></span><input class=\"mono\" data-key=\"MODEL_MIX\"></label>\n            <label class=\"fld\"><span>Evaluation gate <span class=\"k\">MODEL_GATE</span></span><input class=\"mono\" data-key=\"MODEL_GATE\"></label>\n          </details>\n          <details class=\"more\"><summary>Release gate &amp; personality adapter</summary>\n            <label class=\"fld\"><span>Release gate <span class=\"k\">USER_GATE</span></span><input class=\"mono\" data-key=\"USER_GATE\"></label>\n            <label class=\"fld\"><span>Personality adapter (LoRA) <span class=\"k\">USER_LORA</span></span><input class=\"mono\" data-key=\"USER_LORA\"></label>\n          </details>\n          <details class=\"more\"><summary>Salience tuning</summary>\n            <label class=\"fld\"><span>Steer by salience <span class=\"k\">SALIENCE_STEER</span></span><select data-key=\"SALIENCE_STEER\"><option>on</option><option>off</option></select></label>\n            <label class=\"fld\"><span>Bands <span class=\"k\">SALIENCE_BANDS</span></span><input class=\"mono\" data-key=\"SALIENCE_BANDS\"></label>\n          </details>\n          <details class=\"more\"><summary>Base training (nanochat)</summary>\n            <label class=\"fld\"><span>Training arguments <span class=\"k\">NANOCHAT_TRAIN_ARGS</span></span><input class=\"mono\" data-key=\"NANOCHAT_TRAIN_ARGS\"></label>\n            <label class=\"fld\"><span>Repository <span class=\"k\">NANOCHAT_REPO</span></span><input class=\"mono\" data-key=\"NANOCHAT_REPO\"></label>\n            <label class=\"fld\"><span>Distribution <span class=\"k\">NANOCHAT_DIST</span></span><input class=\"mono\" data-key=\"NANOCHAT_DIST\"></label>\n          </details>\n          <details class=\"more\" open><summary>All settings — runtime/agent/botd.properties</summary>\n            <p class=\"para\">Live keys (scoring, the chat provider) apply immediately; each row says when the rest take effect. Blank a value to revert to its default. Secret keys stay file-only. A bright key is explicitly set; a dim one is using its default.</p>\n            <input class=\"cfg-filter mx-cfgfilter\" placeholder=\"filter keys…\" aria-label=\"Filter settings\">\n            <div class=\"cfg\"></div>\n          </details>\n        </div>\n        <aside class=\"mx-explain\">\n          <span class=\"lbl\">expert controls</span>\n          <h4>Details stay accessible.</h4>\n          <p>Everything the friendly sections set is also here as its raw key, plus every other key in the file.</p>\n          <p>Each row shows its effective value, its default, and when a change takes effect.</p>\n          <hr>\n          <p>Secrets remain masked and file-managed, as the settings API requires.</p>\n        </aside></div>\n      </template>\n    </section>","old":"    <section class=\"ag-pane\" data-pane=\"mind\" hidden>\n      <div class=\"ag-mind-grid\">\n        <div class=\"ag-card\" data-card=\"committer\">\n          <p class=\"ag-card-t lbl\">agent autocommit — LLM-written commit messages</p>\n          <div class=\"ag-kv\" data-kv=\"committer\"></div>\n          <span class=\"ag-btnrow\">\n            <select class=\"ag-commit-repo\" title=\"a dev-registered repo to agent-commit\"></select>\n            <button class=\"ag-mind-btn\" data-act=\"commit-toggle\"\n              title=\"toggle agent-commit for the selected repo - on a shadowed repo this also turns dev's mechanical autocommit OFF so the agent drives it\">toggle</button>\n            <button class=\"ag-mind-btn\" data-act=\"commit-sweep\"\n              title=\"run the agent-committer's sweep now - group dirty store units, compose a message each, commit, push\">sweep now</button>\n          </span>\n          <pre class=\"ag-mind-note lbl\" data-note=\"committer\"></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"loop\">\n          <p class=\"ag-card-t lbl\">the loop — executive + sensor</p>\n          <div class=\"ag-kv\" data-kv=\"loop\"></div>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"exec-toggle\">executive…</button>\n            <button class=\"ag-mind-btn\" data-act=\"sensor-toggle\">sensor…</button>\n            <label class=\"lbl\" title=\"executive drive: idle memory-upkeep acts per hour (reverify, connect, wonder, distill). Plan items do not use it - they have their own worker.\">acts/hr <input class=\"ag-drive\" type=\"number\" min=\"0\" value=\"4\"></label>\n            <button class=\"ag-mind-btn\" data-act=\"set-drive\">set</button>\n          </span>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"plan-toggle\"\n              title=\"toggle PLAN_AUTONOMY (persists across restarts) - when armed the plan worker steps accepted / in-progress kb.plan items back to back on its own thread, and goes quiet (no LLM calls) when none are eligible\">plan autonomy…</button>\n            <label class=\"lbl\">max steps/item <input class=\"ag-plansteps\" type=\"number\" min=\"1\" value=\"20\"></label>\n            <button class=\"ag-mind-btn\" data-act=\"set-plansteps\"\n              title=\"set MAX_PLAN_STEPS - the convergence guard: how many autonomous steps one accepted plan item may take before it needs human re-approval\">set</button>\n            <label class=\"lbl\">plan steps/hr <input class=\"ag-planrate\" type=\"number\" min=\"0\" value=\"0\" title=\"0 = unlimited\"></label>\n            <button class=\"ag-mind-btn\" data-act=\"set-planrate\"\n              title=\"set PLAN_STEPS_PER_HOUR - a sliding-hour cap on the plan worker's reasoning turns; 0 = unlimited (the default)\">set</button>\n          </span>\n          <pre class=\"ag-mind-note lbl\" data-note=\"loop\"></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"judge\">\n          <p class=\"ag-card-t lbl\">the judge — resident model service</p>\n          <div class=\"ag-kv\" data-kv=\"judge\"></div>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"bootstrap\"\n              title=\"idempotent oneshot: install env if configured, train if the checkpoint dir is empty, write scripts, launch/converge the service\">bootstrap</button>\n            <button class=\"ag-mind-btn\" data-act=\"promote\"\n              title=\"load the newest ring checkpoint into the inactive slot and swap the live pointer\">promote pointer</button>\n            <button class=\"ag-mind-btn\" data-act=\"release\"\n              title=\"stop the service and free ALL of the agent's GPU memory; ring checkpoints, replay, and metrics survive - resume with bootstrap (loads the newest ring checkpoint). set SALIENCE=off too if you want it to stay off across executive restarts\">release GPU</button>\n          </span>\n          <p class=\"ag-card-t lbl\">the user-facing pointer — stricter lane (8a)</p>\n          <div class=\"ag-kv\" data-kv=\"userptr\"></div>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"user-promote\" hidden\n              title=\"advance the user-facing pointer onto the gate's ready candidate - the deliberate approval the manual mode waits for\">promote user pointer</button>\n            <button class=\"ag-mind-btn\" data-act=\"user-rollback\" hidden\n              title=\"revert the user-facing pointer to last_good (one step; the watchdog does this automatically on agreement decay)\">roll back</button>\n            <button class=\"ag-mind-btn\" data-act=\"rederive\" hidden\n              title=\"re-derive the personality adapter from persona/persona.jsonl against the user pointer's current base - blocks through the LoRA run; the derivation gate can reject it (serving stays untouched). the probe triggers this automatically when the skin slips\">re-derive persona</button>\n          </span>\n          <div class=\"ag-kv\" data-kv=\"persona\"></div>\n          <pre class=\"ag-mind-note lbl\" data-note=\"judge\"></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"flywheel\">\n          <p class=\"ag-card-t lbl\">the flywheel — continuous training</p>\n          <div class=\"ag-kv\" data-kv=\"flywheel\"></div>\n          <div class=\"ag-gate lbl\" data-gate></div>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"export\"\n              title=\"write the accumulated feedstock (salience pairs, claims, curation traces) as a JSONL batch into the trainer's ingest directory\">export curriculum → ingest</button>\n          </span>\n          <pre class=\"ag-mind-note lbl\" data-note=\"flywheel\"></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"forge\" hidden>\n          <p class=\"ag-card-t lbl\">the forge — base training</p>\n          <div class=\"ag-kv\" data-kv=\"forge\"></div>\n          <pre class=\"ag-trainlog\" data-trainlog></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"harvest\">\n          <p class=\"ag-card-t lbl\">the harvest — what the week grew</p>\n          <div class=\"ag-kv\" data-kv=\"harvest\"></div>\n          <pre class=\"ag-mind-note lbl\" data-note=\"harvest\"></pre>\n        </div>\n        <div class=\"ag-card\" data-card=\"stats\">\n          <p class=\"ag-card-t lbl\">statistics — the salience audit trail</p>\n          <div class=\"ag-kv\" data-kv=\"stats\"></div>\n          <div class=\"ag-trends\">\n            <div class=\"ag-trend\"><p class=\"lbl\">trainer loss</p><svg class=\"ag-spark\" data-spark viewBox=\"0 0 100 28\" preserveAspectRatio=\"none\"></svg></div>\n            <div class=\"ag-trend\"><p class=\"lbl\">served verdicts (0 → 1)</p><div class=\"ag-hist\" data-hist></div></div>\n            <div class=\"ag-trend\"><p class=\"lbl\">gates</p><div class=\"ag-gatebar lbl\" data-gatebar>—</div></div>\n          </div>\n          <div class=\"ag-kv\" data-kv=\"sensors\"></div>\n        </div>\n        <div class=\"ag-card\" data-card=\"config\">\n          <p class=\"ag-card-t lbl\">configuration — runtime/agent/botd.properties</p>\n          <p class=\"lbl\">live keys (SALIENCE, the LLM arm) apply immediately; each row says when the rest take effect. blank a value to revert to its default. secret keys stay file-only.</p>\n          <div class=\"ag-conf\" data-conf></div>\n        </div>\n        <div class=\"ag-card\" data-card=\"persona-editor\">\n          <p class=\"ag-card-t lbl\">the persona — how the local model speaks</p>\n          <p class=\"lbl\">one exchange per row; every 5th row is held out for the probe and\n            never trained on. saving takes effect at the service's next gate tick — and a\n            big rewrite can slip the probe and trigger re-derivation on its own.</p>\n          <p class=\"lbl ag-persona-state\" data-persona-state></p>\n          <div class=\"ag-persona\" data-persona></div>\n          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"persona-add\">add exchange</button>\n            <button class=\"ag-mind-btn\" data-act=\"persona-save\"\n              title=\"validate and write the whole corpus (atomic); a bad row rejects the write with its line number\">save persona</button>\n            <button class=\"ag-mind-btn\" data-act=\"persona-reload\"\n              title=\"discard unsaved edits and reload from disk (or the default seed when nothing is saved)\">reload</button>\n          </span>\n          <pre class=\"ag-mind-note lbl\" data-note=\"persona\"></pre>\n        </div>\n      </div>\n    </section>","patch_id":"p199","time":1793188245112},{"author":"alex89romanov","facet":"css","label":"mind tab: replace card-grid styles with the sectioned workspace styles, scoped to the mind pane; keep the shared .ag-chip rules","new":"/* ── the mind tab ─────────────────────────────────────────────────── */\n/* .ag-chip is SHARED: the chat pane's attachment chips render with these\n   rules too (they load after the attachment block, so they win the shared\n   properties). Kept verbatim through the mind redesign on purpose. */\n.ag-chip { display: inline-block; border: 1px solid var(--line); border-radius: 999px;\n  padding: 1px 10px; margin: 0 6px 4px 0; font-size: .8em; }\n.ag-chip.ok { border-color: #3a7; color: #6c9; }\n.ag-chip.warn { border-color: #a83; color: #ca7; }\n.ag-chip.err, .ag-kv-v.err, .ag-mind-note.err { border-color: #a44; color: #c66; }\n.ag-chip.off { opacity: .6; }\n\n/* everything below is the mind workspace, scoped to [data-pane=\"mind\"]\n   (or .mx-* classes only the mind pane uses) so nothing leaks into the\n   other tabs or the mounted plan/stage controls. */\n.mx { flex: 1; min-height: 0; display: flex; flex-direction: column; }\n.mx-heading { flex: none; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;\n  padding: 16px 22px 14px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }\n.mx-heading h2 { font-size: 24px; font-weight: 500; letter-spacing: -.5px; margin: 0 0 2px; }\n.mx-heading p { color: var(--text-dim); font-size: 13px; margin: 0; }\n.mx-keys { display: flex; align-items: center; gap: 10px; color: var(--text-dim); font-size: 12px; }\n\n.mx-work { flex: 1; min-height: 0; display: grid; grid-template-columns: 210px minmax(0, 1fr); }\n.mx-side { border-right: 1px solid var(--line); padding: 14px 10px; display: flex; flex-direction: column; gap: 3px; overflow-y: auto; }\n.ag-app .mx-nav { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;\n  background: none; border: 1px solid transparent; color: var(--text-dim); padding: 8px 10px; border-radius: 8px; }\n.ag-app .mx-nav:hover { color: var(--text); border-color: transparent; }\n.ag-app .mx-nav[aria-current=\"true\"] { background: var(--panel); border-color: var(--line); color: var(--text); }\n.mx-nav svg { width: 16px; height: 16px; flex: none; }\n.mx-nav .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; margin-left: auto; }\n.mx-nav .dot.ok { background: var(--good); } .mx-nav .dot.warn { background: #ca7; }\n.mx-nav .dot.err { backgroun