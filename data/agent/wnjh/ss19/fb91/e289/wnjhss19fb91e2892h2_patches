dendum is instance state in the instance-local `runtime`\n  // library (runtime:agentchataddendum, `addendum` facet — plain text), NOT\n  // library code: fetched lazily and cached like agentloop's corePrompt, a\n  // failed fetch clears the cache so the next ask retries.\n  let addendumPromise = null;\n  const ownerAddendum = () => {\n    if (!addendumPromise) {\n      addendumPromise = (async () => {\n        const r = await readFacet(\"runtime\", \"agentchataddendum\", \"addendum\");\n        if (r?.status === \"ok\" && r.exists) return (r.source ?? \"\").trim();\n        addendumPromise = null;\n        return \"\";\n      })();\n    }\n    return addendumPromise;\n  };","old":"  // the scratchpad (agent.stage) — optional: a page without it still chats\n  const stageCtl = ME.querySelector('[data-control=\"agent:stage\"]')?.api ?? null;\n  const { ADDENDUM } = ME.querySelector('[data-control=\"agent:agentprompt\"]').api;","patch_id":"p137","time":1792321577336},{"author":"agent","facet":"js","label":"assemble the addendum from ownerAddendum()","new":"      const addendum = (await ownerAddendum()).trim();","old":"      const addendum = (ADDENDUM ?? \"\").trim();","patch_id":"p138","time":1792321588832},{"author":"agent","facet":"js","label":"prompts tab: the addendum is now a plain-text facet in runtime, no regex surgery","new":"    { key: \"addendum\", lib: \"runtime\", ctl: \"agentchataddendum\", facet: \"addendum\",\n      cap: \"the OWNER ADDENDUM — appended to every notebook/chat prompt; your experiment surface\" },","old":"    { key: \"addendum\", lib: \"agent\", ctl: \"agentprompt\", facet: \"js\",\n      cap: \"the OWNER ADDENDUM — appended to every notebook/chat prompt; your experiment surface\",\n      extract: (src) => {\n        const m = src.match(/const ADDENDUM = `([\\s\\S]*?)`;/);\n        return m ? m[1].replace(/\\\\`/g, \"`\").replace(/\\\\\\$/g, \"$\").replace(/\\\\\\\\/g, \"\\\\\") : null;\n      },\n      inject: (src, text) => {\n        const esc = text.replace(/\\\\/g, \"\\\\\\\\\").replace(/`/g, \"\\\\`\").replace(/\\$/g, \"\\\\$\");\n        return src.replace(/const ADDENDUM = `[\\s\\S]*?`;/,\n          \"const ADDENDUM = `\" + esc + \"`;\");\n      } },","patch_id":"p139","time":1792321601298},{"author":"agent","facet":"html","label":"remove the hidden agent:agentprompt mount — the addendum now lives in runtime:agentchataddendum","new":"","old":"<div class=\"data-control\" data-control=\"agent:agentprompt\" hidden></div>","patch_id":"p140","time":1792321610213},{"author":"agent","facet":"js","label":"ownerAddendum reads the runtime data record (skip-if-missing), not a control facet","new":"  // The owner addendum is instance state — a DATA RECORD in the instance-local\n  // `runtime` library (id \"agentchataddendum\", data.addendum = plain text), NOT\n  // a control (runtime holds instance data/settings, no controls). The library\n  // may not exist on a fresh install and the addendum is optional, so a missing\n  // library/record simply yields \"\" — skip it, never error. Fetched lazily and\n  // cached like agentloop's corePrompt; a failed read clears the cache so the\n  // next ask retries. Written via app.app.write (the prompts tab creates the\n  // record on first save).\n  let addendumPromise = null;\n  const ownerAddendum = () => {\n    if (!addendumPromise) {\n      addendumPromise = (async () => {\n        try {\n          const r = await invokeP(\"app\", \"app\", \"read\", { lib: \"runtime\", id: \"agentchataddendum\", nn_sessionid: null });\n          if (r?.status === \"ok\" && r.data && typeof r.data.addendum === \"string\") {\n            return r.data.addendum.trim();\n          }\n          return \"\"; // missing library/record/field — no addendum configured\n        } catch (e) {\n          addendumPromise = null; // transient failure — retry next ask\n          return \"\";\n        }\n      })();\n    }\n    return addendumPromise;\n  };","old":"  // The owner addendum is instance state in the instance-local `runtime`\n  // library (runtime:agentchataddendum, `addendum` facet — plain text), NOT\n  // library code: fetched lazily and cached like agentloop's corePrompt, a\n  // failed fetch clears the cache so the next ask retries.\n  let addendumPromise = null;\n  const ownerAddendum = () => {\n    if (!addendumPromise) {\n      addendumPromise = (async () => {\n        const r = await readFacet(\"runtime\", \"agentchataddendum\", \"addendum\");\n        if (r?.status === \"ok\" && r.exists) return (r.source ?? \"\").trim();\n        addendumPromise = null;\n        return \"\";\n      })();\n    }\n    return addendumPromise;\n  };","patch_id":"p141","time":1792322906423},{"author":"agent","facet":"js","label":"prompts tab: the addendum is a runtime data record read/written via app.app.read/write","new":"    { key: \"addendum\", record: true,\n      cap: \"the OWNER ADDENDUM — appended to every notebook/chat prompt; your experiment surface\" },","old":"    { key: \"addendum\", lib: \"runtime\", ctl: \"agentchataddendum\", facet: \"addendum\",\n      cap: \"the OWNER ADDENDUM — appended to every notebook/chat prompt; your experiment surface\" },","patch_id":"p142","time":1792322938680},{"author":"agent","facet":"js","label":"loadPrompts: branch the addendum entry to record read/write, create-on-first-save","new":"    for (const p of PROMPTS) {\n      const block = host.querySelector(`.ag-prompt[data-prompt=\"${p.key}\"]`);\n      const ta = block.querySelector(\"textarea\");\n      const status = block.querySelector(\".ag-prompt-note\");\n      block.querySelector(\".ag-prompt-cap\").textContent = p.cap;\n      // The addendum is a runtime DATA RECORD (id \"agentchataddendum\",\n      // data.addendum), not a control facet: read via app.app.read, written via\n      // app.app.write, and created on first save (the runtime library / record\n      // may not exist yet on a fresh install). Other prompts stay facet patches.\n      if (p.record) {\n        const rec = await invokeP(\"app\", \"app\", \"read\", { lib: \"runtime\", id: \"agentchataddendum\", nn_sessionid: null });\n        ta.value = (rec.status === \"ok\" && rec.data && typeof rec.data.addendum === \"string\")\n          ? rec.data.addendum : \"\";\n        block.querySelector(\".ag-prompt-save\").addEventListener(\"click\", async () => {\n          const wr = await invokeP(\"app\", \"app\", \"write\", {\n            lib: \"runtime\", id: \"agentchataddendum\",\n            data: { addendum: ta.value }, readers: [], writers: [], nn_sessionid: null });\n          note(status, wr.status === \"ok\"\n            ? \"saved — takes effect on the next ask\"\n            : `save failed: ${wr.msg}`, wr.status !== \"ok\");\n        });\n        continue;\n      }\n      const r = await readFacet(p.lib, p.ctl, p.facet);\n      if (r.status !== \"ok\") { status.textContent = \"read failed: \" + r.msg; ta.disabled = true; continue; }\n      let text = r.source;\n      if (p.extract) {\n        const inner = p.extract(r.source);\n        if (inner === null) {\n          status.textContent = \"unexpected facet shape — edit it in the Development app instead\";\n          ta.disabled = true;\n          continue;\n        }\n        text = inner;\n      }\n      ta.value = text;\n      block.querySelector(\".ag-prompt-save\").addEventListener(\"click\", async () => {\n        const cur = await readFacet(p.lib, p.ctl, p.facet);\n        if (cur.status !== \"ok\") { note(status, \"re-read failed: \" + cur.msg, true); return; }\n        const next = p.inject ? p.inject(cur.source, ta.value) : ta.value;\n        const pr = await patchFacet(p.lib, p.ctl, p.facet,\n          { oldSnippet: cur.source, newSnippet: next, base: cur.hash,\n            label: `prompt: ${p.key} edited in the agent app` });\n        note(status, pr.status === \"ok\"\n          ? \"saved (journaled) — takes effect on the next ask\"\n          : `save failed: ${pr.msg}`, pr.status !== \"ok\");\n      });\n    }\n  }","old":"    for (const p of PROMPTS) {\n      const block = host.querySelector(`.ag-prompt[data-prompt=\"${p.key}\"]`);\n      const ta = block.querySelector(\"textarea\");\n      const status = block.querySelector(\".ag-prompt-note\");\n      block.querySelector(\".ag-prompt-cap\").textContent = p.cap;\n      const r = await readFacet(p.lib, p.ctl, p.facet);\n      if (r.status !== \"ok\") { status.textContent = \"read failed: \" + r.msg; ta.disabled = true; continue; }\n      let text = r.source;\n      if (p.extract) {\n        const inner = p.extract(r.source);\n        if (inner === null) {\n          status.textContent = \"unexpected facet shape — edit it in the Development app instead\";\n          ta.disabled = true;\n          continue;\n        }\n        text = inner;\n      }\n      ta.value = text;\n      block.querySelector(\".ag-prompt-save\").addEventListener(\"click\", async () => {\n        const cur = await readFacet(p.lib, p.ctl, p.facet);\n        if (cur.status !== \"ok\") { note(status, \"re-read failed: \" + cur.msg, true); return; }\n        const next = p.inject ? p.inject(cur.source, ta.value) : ta.value;\n        const pr = await patchFacet(p.lib, p.ctl, p.facet,\n          { oldSnippet: cur.source, newSnippet: next, base: cur.hash,\n            label: `prompt: ${p.key} edited in the agent app` });\n        note(status, pr.status === \"ok\"\n          ? \"saved (journaled) — takes effect on the next ask\"\n          : `save failed: ${pr.msg}`, pr.status !== \"ok\");\n      });\n    }\n  }","patch_id":"p143","time":1792322970003},{"author":"executive","facet":"html","label":"add plan-autonomy controls to loop card","new":"          <span class=\"ag-btnrow\">\n            <button class=\"ag-mind-btn\" data-act=\"exec-toggle\">executive…</button>\n            <button class=\"ag-mind-btn\" data-act=\"sensor-toggle\">sensor…</button>\n            <label class=\"lbl\">acts/hr <input class=\"ag-drive\" type=\"number\" 