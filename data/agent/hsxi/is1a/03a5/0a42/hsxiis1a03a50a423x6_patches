 }\n.pl-activity-grip::after { content: ''; position: absolute; left: 50%; top: 3px;\n  width: 40px; height: 4px; margin-left: -20px; border-radius: 2px;\n  background: var(--line); transition: background .12s; }\n.pl-activity-grip:hover::after, .pl-activity-grip.dragging::after,\n.pl-activity-grip:focus-visible::after { background: var(--accent, #f0a63c); }\n.pl-activity[hidden] + .pl-activity-grip { display: none; }\n","old":".pl-activity[hidden] { display: none; }\n","patch_id":"p106","time":1792946795226},{"author":"agent","facet":"js","label":"activity panel: drag-to-resize bottom edge","new":"// Resizable activity panel: drag the grip under its bottom edge (or focus it\n// and use ↑/↓, shift for bigger steps). The height is a per-browser view\n// preference in localStorage, not plan data; double-click resets to the\n// automatic max-height.\nvar ACT_H_KEY = 'agent.plan.activityHeight';\nfunction initActivityResize() {\n  var panel = ME.querySelector('.pl-activity');\n  var grip = ME.querySelector('.pl-activity-grip');\n  if (!panel || !grip) return;\n  function apply(h, save) {\n    if (h == null) {\n      panel.style.height = ''; panel.classList.remove('sized');\n      if (save) try { localStorage.removeItem(ACT_H_KEY); } catch (e) {}\n      return;\n    }\n    var wrap = ME.querySelector('.pl-wrap');\n    var room = wrap ? wrap.clientHeight : 0;\n    if (room > 0) h = Math.min(h, Math.max(120, room - 140)); // leave the board visible\n    h = Math.round(Math.max(80, h));\n    panel.style.height = h + 'px'; panel.classList.add('sized');\n    if (save) try { localStorage.setItem(ACT_H_KEY, String(h)); } catch (e) {}\n  }\n  var saved = 0;\n  try { saved = parseInt(localStorage.getItem(ACT_H_KEY), 10) || 0; } catch (e) {}\n  if (saved > 0) apply(saved, false);\n  var startY = 0, startH = 0;\n  grip.addEventListener('pointerdown', function (ev) {\n    if (ev.button !== 0) return;\n    ev.preventDefault();\n    startY = ev.clientY; startH = panel.getBoundingClientRect().height;\n    grip.setPointerCapture(ev.pointerId);\n    grip.classList.add('dragging');\n  });\n  grip.addEventListener('pointermove', function (ev) {\n    if (grip.classList.contains('dragging')) apply(startH + ev.clientY - startY, false);\n  });\n  function end() {\n    if (!grip.classList.contains('dragging')) return;\n    grip.classList.remove('dragging');\n    apply(panel.getBoundingClientRect().height, true);\n  }\n  grip.addEventListener('pointerup', end);\n  grip.addEventListener('pointercancel', end);\n  grip.addEventListener('lostpointercapture', end);\n  grip.addEventListener('dblclick', function () { apply(null, true); });\n  grip.addEventListener('keydown', function (ev) {\n    if (ev.key !== 'ArrowUp' && ev.key !== 'ArrowDown') return;\n    ev.preventDefault();\n    var step = (ev.shiftKey ? 60 : 20) * (ev.key === 'ArrowDown' ? 1 : -1);\n    apply(panel.getBoundingClientRect().height + step, true);\n  });\n}\n\nme.ready = function () {\n  initActivityResize();\n  ME.querySelectorAll('[data-runact]').forEach(function (b) {","old":"me.ready = function () {\n  ME.querySelectorAll('[data-runact]').forEach(function (b) {","patch_id":"p107","time":1792946795232},{"author":"agent","facet":"js","label":"activity resize: window-level drag tracking, guarded capture","new":"  var startY = 0, startH = 0;\n  function move(ev) { apply(startH + ev.clientY - startY, false); }\n  function end() {\n    window.removeEventListener('pointermove', move);\n    window.removeEventListener('pointerup', end);\n    window.removeEventListener('pointercancel', end);\n    if (!grip.classList.contains('dragging')) return;\n    grip.classList.remove('dragging');\n    apply(panel.getBoundingClientRect().height, true);\n  }\n  grip.addEventListener('pointerdown', function (ev) {\n    if (ev.button !== 0) return;\n    ev.preventDefault();\n    startY = ev.clientY; startH = panel.getBoundingClientRect().height;\n    try { grip.setPointerCapture(ev.pointerId); } catch (e) {}\n    g