{"data":{"list":[{"author":"agent","facet":"html","label":"plan board html","new":"<!-- plan — kanban over kb.plan: columns are the lifecycle tags the\n     epistemic work queue derives from; dragging a card is a journaled\n     tags edit on the entry, nothing else. -->\n<div class=\"pl-wrap\">\n  <header class=\"pl-head\">\n    <span class=\"lbl\">kb.plan — drag a card to change its lifecycle; the epistemic work queue reshapes itself from these tags</span>\n    <button class=\"pl-refresh\" title=\"reload the board from kb.plan\">refresh</button>\n    <span class=\"pl-note lbl\"></span>\n  </header>\n  <div class=\"pl-board\"></div>\n  <form class=\"pl-add\">\n    <input class=\"pl-add-claim\" placeholder=\"new plan item — one atomic claim\" aria-label=\"New plan item claim\">\n    <input class=\"pl-add-detail\" placeholder=\"detail — the why (optional)\" aria-label=\"Detail\">\n    <button type=\"submit\">+ proposed</button>\n  </form>\n</div>\n","old":"","patch_id":"p1","time":1787684812050},{"author":"agent","facet":"css","label":"plan board css","new":".pl-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column;\n  padding: 12px 16px; gap: 10px; }\n.pl-head { display: flex; align-items: center; gap: 12px; flex: none; }\n.pl-refresh { background: none; border: 1px solid var(--line); border-radius: 8px;\n  padding: 3px 10px; color: var(--text-dim); cursor: pointer; }\n.pl-refresh:hover { color: var(--text); }\n.pl-note.err { color: var(--bad, #c0564f); }\n\n.pl-board { flex: 1; min-height: 0; display: flex; gap: 10px; overflow-x: auto; }\n.pl-col { flex: 1; min-width: 190px; display: flex; flex-direction: column;\n  border: 1px solid var(--line); border-radius: 10px; background: var(--panel);\n  min-height: 0; }\n.pl-col.over { border-color: var(--accent, #f0a63c); }\n.pl-col-h { flex: none; padding: 8px 10px; border-bottom: 1px solid var(--line);\n  text-transform: uppercase; letter-spacing: .06em; font-size: .75em;\n  color: var(--text-dim); display: flex; justify-content: space-between; }\n.pl-col-cards { flex: 1; min-height: 40px; overflow-y: auto; padding: 8px;\n  display: flex; flex-direction: column; gap: 8px; }\n.pl-col[data-lifecycle=\"done\"] .pl-card,\n.pl-col[data-lifecycle=\"abandoned\"] .pl-card { opacity: .55; }\n\n.pl-card { border: 1px solid var(--line); border-radius: 8px; padding: 7px 9px;\n  background: var(--bg); cursor: grab; font-size: .88em; }\n.pl-card.dragging { opacity: .4; }\n.pl-card-claim { overflow-wrap: anywhere; }\n.pl-card-meta { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 4px 8px;\n  font-size: .82em; color: var(--text-faint); }\n.pl-card-detail { margin-top: 6px; font-size: .9em; color: var(--text-dim);\n  white-space: pre-wrap; overflow-wrap: anywhere; border-top: 1px solid var(--line);\n  padding-top: 6px; }\n.pl-card-detail[hidden] { display: none; }\n\n.pl-add { flex: none; display: flex; gap: 8px; }\n.pl-add input { flex: 1; min-width: 0; background: var(--bg); color: var(--text);\n  border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; }\n.pl-add .pl-add-detail { flex: 2; }\n.pl-add button { background: none; border: 1px solid var(--line); border-radius: 8px;\n  padding: 6px 12px; color: var(--text-dim); cursor: pointer; white-space: nowrap; }\n.pl-add button:hover { color: var(--text); }\n","old":"","patch_id":"p2","time":1787684825003},{"author":"agent","facet":"js","label":"plan board js","new":"// plan.js — kanban over kb.plan. The board is a VIEW: columns are the\n// lifecycle tokens in each entry's tags (the same tokens epistemic_work\n// derives the plan queue from). A drop calls move_item, which rewrites\n// that one entry's tags through the journaled patch_control_facet with\n// the board's hash as concurrency token — stale_base means someone else\n// wrote kb.plan since we loaded, so we reload and ask again.\nvar me = this;\nvar ME = $('#' + me.UUID)[0];\n\nvar LIFECYCLES = ['proposed', 'accepted', 'in-progress', 'done', 'abandoned'];\nvar boardHash = '';\nvar dragClaim = null;\n\nfunction note(txt, isErr) {\n  var n = ME.querySelector('.pl-note');\n  n.textContent = txt || '';\n  n.classList.toggle('err', !!isErr);\n}\n\nfunction lifecycleOf(tags) {\n  var toks = String(tags || '').split(',').map(function (t) { return t.trim(); });\n  for (var i = 0; i < LIFECYCLES.length; i++) {\n    if (toks.indexOf(LIFECYCLES[i]) >= 0) return LIFECYCLES[i];\n  }\n  return 'proposed'; // untagged entries surface here; a move normalizes them\n}\n\nfunction card(e) {\n  var el = document.createElement('div');\n  el.className = 'pl-card';\n  el.draggable = true;\n  el.dataset.claim = e.claim || '';\n\n  var c = document.createElement('div');\n  c.className = 'pl-card-claim';\n  c.textContent = e.claim || '(no claim)';\n  el.appendChild(c);\n\n  var meta = document.createElement('div');\n  meta.className = 'pl-card-meta';\n  var bits = [];\n  if (e.confidence) bits.push(e.confidence);\n  if (e.time) bits.push(new Date(e.time).toISOString().slice(0, 10));\n  var extra = String(e.tags || '').split(',').map(function (t) { return t.trim(); })\n    .filter(function (t) { return t && t !== 'plan' && LIFECYCLES.indexOf(t) < 0; });\n  if (extra.length) bits.push(extra.join(' · '));\n  meta.textContent = bits.join('  ·  ');\n  el.appendChild(meta);\n\n  if (e.detail) {\n    var d = document.createElement('div');\n    d.className = 'pl-card-detail';\n    d.textContent = e.detail;\n    d.hidden = true;\n    el.appendChild(d);\n    el.addEventListener('click', function () { d.hidden = !d.hidden; });\n    el.title = 'click to show/hide detail — drag to change lifecycle';\n  } else {\n    el.title = 'drag to change lifecycle';\n  }\n\n  el.addEventListener('dragstart', function (ev) {\n    dragClaim = e.claim || '';\n    el.classList.add('dragging');\n    ev.dataTransfer.setData('text/plain', dragClaim);\n    ev.dataTransfer.effectAllowed = 'move';\n  });\n  el.addEventListener('dragend', function () {\n    dragClaim = null;\n    el.classList.remove('dragging');\n  });\n  return el;\n}\n\nfunction render(entries) {\n  var board = ME.querySelector('.pl-board');\n  board.textContent = '';\n  var byCol = {};\n  LIFECYCLES.forEach(function (l) { byCol[l] = []; });\n  (entries || []).forEach(function (e) {\n    if (!e || !e.claim) return; // skip the line-format terminator object\n    byCol[lifecycleOf(e.tags)].push(e);\n  });\n  LIFECYCLES.forEach(function (l) {\n    byCol[l].sort(function (a, b) { return (b.time || 0) - (a.time || 0); });\n    var col = document.createElement('div');\n    col.className = 'pl-col';\n    col.dataset.lifecycle = l;\n\n    var h = document.createElement('div');\n    h.className = 'pl-col-h';\n    h.innerHTML = '<span></span><span></span>';\n    h.firstChild.textContent = l;\n    h.lastChild.textContent = byCol[l].length;\n    col.appendChild(h);\n\n    var cards = document.createElement('div');\n    cards.className = 'pl-col-cards';\n    byCol[l].forEach(function (e) { cards.appendChild(card(e)); });\n    col.appendChild(cards);\n\n    col.addEventListener('dragover', function (ev) {\n      if (dragClaim === null) return;\n      ev.preventDefault();\n      ev.dataTransfer.dropEffect = 'move';\n      col.classList.add('over');\n    });\n    col.addEventListener('dragleave', function () { col.classList.remove('over'); });\n    col.addEventListener('drop', function (ev) {\n      ev.preventDefault();\n      col.classList.remove('over');\n      var claim = ev.dataTransfer.getData('text/plain') || dragClaim;\n      if (!claim) return;\n      note('moving to ' + l + '…');\n      send_move_item(claim, l, boardHash, null, function (r) {\n        if (r && r.status === 'ok') { note(''); load(); }\n        else if (r && r.msg === 'stale_base') {\n          note('kb.plan changed underneath — reloaded, drop again', true);\n          load();\n        } else {\n          note((r && r.msg) || 'move failed', true);\n        }\n      });\n    });\n    board.appendChild(col);\n  });\n}\n\nfunction load() {\n  send_board(function (r) {\n    if (r && r.status === 'ok') {\n      boardHash = r.hash || '';\n      render(r.entries || []);\n    } else {\n      note((r && r.msg) || 'load failed', true);\n    }\n  });\n}\n\nme.ready = function () {\n  ME.querySelector('.pl-refresh').addEventListener('click', function () { note(''); load(); });\n  ME.querySelector('.pl-add').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var claimEl = ME.querySelector('.pl-add-claim');\n    var detailEl = ME.querySelector('.pl-add-detail');\n    var claim = claimEl.value.trim();\n    if (!claim) return;\n    note('filing…');\n    send_add_item(claim, detailEl.value.trim(), null, function (r) {\n      if (r && r.status === 'ok') { claimEl.value = ''; detailEl.value = ''; note(''); load(); }\n      else note((r && r.msg) || 'add failed', true);\n    });\n  });\n  load();\n};\n","old":"","patch_id":"p3","time":1787684849137},{"author":"agent","facet":"js","label":"de-jQuery: vanilla ME lookup","new":"var me = this;\nvar ME = document.getElementById(me.UUID);","old":"var me = this;\nvar ME = $('#' + me.UUID)[0];","patch_id":"p4","time":1788784439657},{"author":"executive","facet":"js","label":"add `completed` lifecycle column (verified-done, awaiting human review)","new":"var LIFECYCLES = ['proposed', 'accepted', 'in-progress', 'completed', 'done', 'abandoned'];","old":"var LIFECYCLES = ['proposed', 'accepted', 'in-progress', 'done', 'abandoned'];","patch_id":"p5","time":1792522789243},{"author":"executive","facet":"js","label":"render rolling `latest` progress note on the card","new":"  meta.textContent = bits.join('  ·  ');\n  el.appendChild(meta);\n\n  // rolling-latest: the agent's most recent step headline (written by step_item\n  // each tick). The live pulse of the card - progress visible without opening\n  // step_log. Show status + relative time + the note.\n  if (e.latest && e.latest.note) {\n    var lt = document.createElement('div');\n    lt.className = 'pl-card-latest';\n    var when = e.latest.time ? relTime(e.latest.time) : '';\n    var st = e.latest.status ? e.latest.status.toLowerCase().replace(/_/g, ' ') : '';\n    lt.textContent = (st ? st : 'update') + (when ? ' · ' + when : '') + ' — ' + e.latest.note;\n    lt.title = 'latest step (of ' + (e.step_log ? e.step_log.length : 0) + ') — ' + (e.latest.note || '');\n    el.appendChild(lt);\n  }\n","old":"  meta.textContent = bits.join('  ·  ');\n  el.appendChild(meta);\n","patch_id":"p6","time":1792548179518},{"author":"executive","facet":"js","label":"add relTime helper for latest-step timestamps","new":"function lifecycleOf(tags) {\n  var toks = String(tags || '').split(',').map(function (t) { return t.trim(); });\n  for (var i = 0; i < LIFECYCLES.length; i++) {\n    if (toks.indexOf(LIFECYCLES[i]) >= 0) return LIFECYCLES[i];\n  }\n  return 'proposed'; // untagged entries surface here; a move normalizes them\n}\n\nfunction relTime(ms) {\n  var d = Date.now() - ms;\n  if (d < 0) d = 0;\n  var m = Math.floor(d / 60000);\n  if (m < 1) return 'just now';\n  if (m < 60) return m + 'm ago';\n  var h = Math.floor(m / 60);\n  if (h < 24) return h + 'h ago';\n  return Math.floor(h / 24) + 'd ago';\n}\n","old":"function lifecycleOf(tags) {\n  var toks = String(tags || '').split(',').map(function (t) { return t.trim(); });\n  for (var i = 0; i < LIFECYCLES.length; i++) {\n    if (toks.indexOf(LIFECYCLES[i]) >= 0) return LIFECYCLES[i];\n  }\n  return 'proposed'; // untagged entries surface here; a move normalizes them\n}\n","patch_id":"p7","time":1792548199901},{"author":"executive","facet":"css","label":"style the rolling-latest progress line","new":".pl-card-meta { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 4px 8px;\n  font-size: .82em; color: var(--text-faint); }\n.pl-card-latest { margin-top: 6px; font-size: .82em; color: var(--accent, #f0a63c);\n  line-height: 1.3; overflow-wrap: anywhere; border-left: 2px solid var(--accent, #f0a63c);\n  padding-left: 6px; }","old":".pl-card-meta { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 4px 8px;\n  font-size: .82em; color: var(--text-faint); }","patch_id":"p8","time":1792548227585},{"author":"agent","facet":"css","label":"render full multi-line latest note (pre-wrap)","new":".pl-card-latest { margin-top: 6px; font-size: .82em; color: var(--accent, #f0a63c);\n  line-height: 1.3; overflow-wrap: anywhere; border-left: 2px solid var(--accent, #f0a63c);\n  padding-left: 6px; white-space: pre-wrap; }","old":".pl-card-latest { margin-top: 6px; font-size: .82em; color: var(--accent, #f0a63c);\n  line-height: 1.3; overflow-wrap: anywhere; border-left: 2px solid var(--accent, #f0a63c);\n  padding-left: 6px; }","patch_id":"p9","time":1792583269986},{"author":"agent","cmd":"worker_boot","facet":"timer","label":"set timer worker_boot","new":"{\"cmd\":\"xgjxlq1a164f67b75ocbf\",\"cmddb\":\"agent\",\"cmdlib\":\"agent\",\"id\":\"xslmkq1a164f74a70kcc7\",\"interval\":0,\"intervalunit\":\"seconds\",\"name\":\"worker_boot\",\"params\":{},\"repeat\":false,\"start\":10,\"startunit\":\"seconds\"}","old":"","patch_id":"p10","time":1792695290481},{"author":"plan-step-engine","facet":"js","label":"plan board: live-update state (poll + open-detail memory)","new":"var dragClaim = null;\n\n// LIVE UPDATE: the board polls the cheap board_hash probe (just kb.plan's\n// facet hash, no entries) every POLL_MS while it is actually on screen, and\n// reloads the full board only when the hash moves - so a step_item tick, a\n// move from another tab, or an add_item lands within a few seconds without\n// shipping the whole facet each tick. A re-render that would land mid-drag\n// is deferred to dragend; expanded details survive a re-render.\nvar POLL_MS = 3000;\nvar pollTimer = null;\nvar probing = false;\nvar loading = false;\nvar reloadPending = false;\nvar openClaims = {};\n\nfunction onScreen() {\n  if (!ME || !ME.isConnected) return false;\n  if (document.visibilityState === 'hidden') return false;\n  return ME.offsetParent !== null || ME.getClientRects().length > 0;\n}\n\nfunction refreshTimes() {\n  var lts = ME.querySelectorAll('.pl-card-latest[data-time]');\n  for (var i = 0; i < lts.length; i++) {\n    var lt = lts[i];\n    var t = Number(lt.dataset.time);\n    if (!t) continue;\n    lt.textContent = lt.dataset.st + ' · ' + relTime(t) + ' — ' + lt.dataset.note;\n  }\n}\n\nfunction probe() {\n  if (!ME.isConnected) { if (pollTimer) clearInterval(pollTimer); pollTimer = null; return; }\n  if (probing || loading || !onScreen()) return;\n  refreshTimes();\n  probing = true;\n  send_board_hash(function (r) {\n    probing = false;\n    if (r && r.status === 'ok' && (r.hash || '') !== boardHash) {\n      if (dragClaim !== null) reloadPending = true; else load();\n    }\n  });\n}","old":"var dragClaim = null;","patch_id":"p11","time":1792698448307},{"author":"plan-step-engine","facet":"js","label":"plan board: latest-line relative time refreshes in place","new":"    lt.textContent = (st ? st : 'update') + (when ? ' · ' + when : '') + ' — ' + e.latest.note;\n    if (e.latest.time) {\n      lt.dataset.time = String(e.latest.time);\n      lt.dataset.st = st ? st : 'update';\n      lt.dataset.note = e.latest.note;\n    }","old":"    lt.textContent = (st ? st : 'update') + (when ? ' · ' + when : '') + ' — ' + e.latest.note;","patch_id":"p12","time":1792698453784},{"author":"plan-step-engine","facet":"js","label":"plan board: expanded details survive live re-render","new":"    d.hidden = !openClaims[e.claim || ''];\n    el.appendChild(d);\n    el.addEventListener('click', function () {\n      d.hidden = !d.hidden;\n      if (d.hidden) delete openClaims[e.claim || '']; else openClaims[e.claim || ''] = true;\n    });","old":"    d.hidden = true;\n    el.appendChild(d);\n    el.addEventListener('click', function () { d.hidden = !d.hidden; });","patch_id":"p13","time":1792698457877},{"author":"plan-step-engine","facet":"js","label":"plan board: deferred reload fires at dragend","new":"  el.addEventListener('dragend', function () {\n    dragClaim = null;\n    el.classList.remove('dragging');\n    if (reloadPending) { reloadPending = false; setTimeout(load, 0); }\n  });","old":"  el.addEventListener('dragend', function () {\n    dragClaim = null;\n    el.classList.remove('dragging');\n  });","patch_id":"p14","time":1792698462364},{"author":"plan-step-engine","facet":"js","label":"plan board: single-flight load; poll starts on ready and on becoming visible","new":"function load() {\n  if (loading) { reloadPending = true; return; }\n  loading = true;\n  send_board(function (r) {\n    loading = false;\n    if (r && r.status === 'ok') {\n      boardHash = r.hash || '';\n      render(r.entries || []);\n    } else {\n      note((r && r.msg) || 'load failed', true);\n    }\n    if (reloadPending && dragClaim === null) { reloadPending = false; load(); }\n  });\n}\n\nfunction startLive() {\n  if (!pollTimer) pollTimer = setInterval(probe, POLL_MS);\n  // the plan pane starts hidden inside the chat's tab strip: probe the moment\n  // it (or the browser tab) comes back on screen instead of waiting a tick\n  if (window.IntersectionObserver) {\n    new IntersectionObserver(function (ents) {\n      for (var i = 0; i < ents.length; i++) if (ents[i].isIntersecting) { probe(); break; }\n    }).observe(ME);\n  }\n  document.addEventListener('visibilitychange', function () {\n    if (document.visibilityState === 'visible') probe();\n  });\n}\n\nme.ready = function () {\n  startLive();","old":"function load() {\n  send_board(function (r) {\n    if (r && r.status === 'ok') {\n      boardHash = r.hash || '';\n      render(r.entries || []);\n    } else {\n      note((r && r.msg) || 'load failed', true);\n    }\n  });\n}\n\nme.ready = function () {","patch_id":"p15","time":1792698471509}]},"id":"hsxiis1a03a50a423x6_patches","readers":[],"time":1792698471509,"username":"system","writers":[]}