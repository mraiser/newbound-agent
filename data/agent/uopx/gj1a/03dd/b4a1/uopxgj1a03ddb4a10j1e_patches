{"data":{"list":[{"author":"agent","facet":"html","label":"browser_builder wizard html","new":"<div class=\"nbld\">\n  <div class=\"nbld-head\">\n    <h1>Noobscape&nbsp;v2 Builder</h1>\n    <p class=\"nbld-sub\">Build Marc's chrome-privileged Firefox fork &mdash; the browser <code>agent.browser</code> drives &amp; grabmore scrapes with &mdash; from source, patch in the v2 file-RPC mechanism, and install it where both look.</p>\n    <button class=\"nbld-refresh\" data-act=\"refresh\">&#8635; Refresh</button>\n  </div>\n\n  <div class=\"nbld-card\">\n    <h2>1 &middot; Configuration</h2>\n    <p class=\"nbld-note\">The install path is a config option, so the build can live anywhere and still be found. <code>NOOBSCAPE_BIN</code> defaults to <code>/noobscape/bin/firefox</code> &mdash; grabmore's hardcoded path &mdash; and <code>agent.browser</code> reads it too.</p>\n    <div class=\"nbld-grid\">\n      <label>Build workspace<input type=\"text\" data-cfg=\"NOOBSCAPE_WORKSPACE\" placeholder=\"/newbound/runtime/agent/noobscape-build\"><small>Needs ~40&nbsp;GB free. Anywhere you like.</small></label>\n      <label>Firefox version<input type=\"text\" data-cfg=\"NOOBSCAPE_VERSION\" placeholder=\"128.0esr\"><small>Any 128.x ESR point release.</small></label>\n      <label>Install path (NOOBSCAPE_BIN)<input type=\"text\" data-cfg=\"NOOBSCAPE_BIN\" placeholder=\"/noobscape/bin/firefox\"><small>Where the binary/symlink lands.</small></label>\n      <label>Channel dir (NOOBSCAPE_DIR)<input type=\"text\" data-cfg=\"NOOBSCAPE_DIR\" placeholder=\"/noobscape\"><small>inject.js / inject.out live here.</small></label>\n      <label>Display (BROWSER_DISPLAY)<input type=\"text\" data-cfg=\"BROWSER_DISPLAY\" placeholder=\"(empty = headless)\"><small>e.g. :99 to watch over VNC.</small></label>\n    </div>\n    <button class=\"nbld-btn\" data-act=\"saveconfig\">Save configuration</button>\n    <span class=\"nbld-cfgmsg\"></span>\n  </div>\n\n  <div class=\"nbld-card\">\n    <h2>2 &middot; Build pipeline</h2>\n    <p class=\"nbld-note\">Run the steps in order. Download &rarr; extract &rarr; deps &rarr; build are long (30&nbsp;min&ndash;hours, background); the log below streams while they run.</p>\n    <ol class=\"nbld-steps\">\n      <li data-step=\"materialize\"><span class=\"dot\"></span><span class=\"lbl\">Materialize kit</span><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"materialize\">Run</button></li>\n      <li data-step=\"extract\"><span class=\"dot\"></span><span class=\"lbl\">Download &amp; extract source</span><span class=\"grp\"><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"download\">Download</button><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"extract\">Extract</button></span></li>\n      <li data-step=\"patched\"><span class=\"dot\"></span><span class=\"lbl\">Patch (v2 nsDocShell mechanism)</span><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"patch\">Run</button></li>\n      <li data-step=\"deps\"><span class=\"dot\"></span><span class=\"lbl\">Install build deps (mach bootstrap)</span><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"deps\">Run</button></li>\n      <li data-step=\"built\"><span class=\"dot\"></span><span class=\"lbl\">Build Firefox</span><button class=\"nbld-btn sm\" data-act=\"stage\" data-stage=\"build\">Run</button></li>\n    </ol>\n  </div>\n\n  <div class=\"nbld-card\">\n    <h2>3 &middot; Install</h2>\n    <p class=\"nbld-note\">Point <code>NOOBSCAPE_BIN</code> at the built browser. <b>Symlink</b> is the light default; <b>copy</b> clones the whole <code>dist/bin</code> so it survives cleaning the workspace.</p>\n    <div class=\"nbld-install\">\n      <label class=\"inline\"><input type=\"radio\" name=\"nbmode\" value=\"symlink\" checked> symlink</label>\n      <label class=\"inline\"><input type=\"radio\" name=\"nbmode\" value=\"copy\"> copy</label>\n      <button class=\"nbld-btn\" data-act=\"install\">Install</button>\n      <span class=\"nbld-installmsg\"></span>\n    </div>\n  </div>\n\n  <div class=\"nbld-card\">\n    <h2>Build monitor <span class=\"nbld-run\" style=\"display:none\"></span></h2>\n    <div class=\"nbld-monitor-bar\">\n      <span class=\"nbld-stage\"></span>\n      <button class=\"nbld-btn sm danger\" data-act=\"stop\" style=\"display:none\">Stop build</button>\n    </div>\n    <pre class=\"nbld-log\">(no build log yet)</pre>\n  </div>\n</div>","old":"","patch_id":"p1","time":1787744491393},{"author":"agent","facet":"css","label":"browser_builder wizard css","new":".nbld{max-width:900px;margin:0 auto;padding:18px;font-family:-apple-system,Segoe UI,Roboto,sans-serif;color:#d7dde3;font-size:14px;line-height:1.45}\n.nbld h1{font-size:22px;margin:0;color:#fff}\n.nbld h2{font-size:15px;margin:0 0 8px;color:#9fd0ff;font-weight:600}\n.nbld-head{position:relative;margin-bottom:16px}\n.nbld-sub{color:#9aa4ad;margin:6px 0 0;max-width:680px}\n.nbld-refresh{position:absolute;top:0;right:0;background:#243040;color:#cfe3ff;border:1px solid #3a4a60;border-radius:6px;padding:6px 10px;cursor:pointer}\n.nbld-refresh:hover{background:#2c3a4d}\n.nbld-card{background:#171d25;border:1px solid #263140;border-radius:10px;padding:16px;margin-bottom:14px}\n.nbld-note{color:#8f99a3;margin:0 0 12px;font-size:13px}\n.nbld code{background:#0e1319;padding:1px 5px;border-radius:4px;color:#e6c07b;font-size:12px}\n.nbld-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.nbld-grid label{display:flex;flex-direction:column;font-size:12px;color:#9aa4ad;gap:4px}\n.nbld-grid input{background:#0e1319;border:1px solid #2b3644;border-radius:6px;padding:8px;color:#e8edf2;font-size:13px;font-family:ui-monospace,Menlo,monospace}\n.nbld-grid input:focus{outline:none;border-color:#4a86c8}\n.nbld-grid small{color:#5f6b76;font-size:11px}\n.nbld-btn{background:#2b6cb0;color:#fff;border:none;border-radius:6px;padding:9px 16px;cursor:pointer;font-size:13px;margin-top:12px}\n.nbld-btn:hover{background:#3a7cc0}\n.nbld-btn.sm{padding:5px 12px;margin:0;font-size:12px}\n.nbld-btn.danger{background:#a33}\n.nbld-btn.danger:hover{background:#c44}\n.nbld-btn:disabled{background:#3a4653;color:#7c8894;cursor:not-allowed}\n.nbld-cfgmsg,.nbld-installmsg{margin-left:12px;font-size:12px;color:#7fd18f}\n.nbld-steps{list-style:none;margin:0;padding:0}\n.nbld-steps li{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #1f2732}\n.nbld-steps li:last-child{border-bottom:none}\n.nbld-steps .lbl{flex:1}\n.nbld-steps .grp{display:flex;gap:6px}\n.nbld-steps .dot{width:11px;height:11px;border-radius:50%;background:#3a4653;flex:none;box-shadow:0 0 0 3px #12171d}\n.nbld-steps li.done .dot{background:#4caf7d}\n.nbld-steps li.done .lbl{color:#8fb7a3}\n.nbld-install{display:flex;align-items:center;gap:14px;flex-wrap:wrap}\n.nbld-install label.inline{display:inline-flex;align-items:center;gap:5px;font-size:13px;color:#cfd6dd}\n.nbld-run{font-size:12px;color:#111;background:#e6b800;border-radius:10px;padding:2px 9px;font-weight:600;vertical-align:middle}\n.nbld-monitor-bar{display:flex;align-items:center;gap:12px;margin-bottom:8px;min-height:24px}\n.nbld-stage{font-size:12px;color:#9aa4ad;font-family:ui-monospace,monospace}\n.nbld-log{background:#0a0e13;border:1px solid #1f2732;border-radius:8px;padding:12px;color:#a8c7a8;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;line-height:1.4;max-height:340px;overflow:auto;white-space:pre-wrap;margin:0}\n@media(max-width:640px){.nbld-grid{grid-template-columns:1fr}}","old":"","patch_id":"p2","time":1787744513021},{"author":"agent","facet":"js","label":"browser_builder wizard js","new":"var me = this;\nvar ME = $('#' + me.UUID)[0];\nme.pollTimer = null;\nme.loaded = false;\n\nfunction U(r){ return (r && typeof r === 'object' && r.data) ? r.data : r; }\nfunction $f(sel){ return $(ME).find(sel); }\n\nme.ready = function(){\n  $(ME).on('click', '[data-act]', function(){\n    var act = $(this).attr('data-act');\n    if (act === 'refresh')      me.refresh();\n    else if (act === 'saveconfig') me.saveConfig(this);\n    else if (act === 'stage')   me.runStage($(this).attr('data-stage'), this);\n    else if (act === 'install') me.doInstall(this);\n    else if (act === 'stop')    me.stopBuild(this);\n  });\n  me.refresh();\n};\n\nme.refresh = function(){\n  send_builder_status(function(r){\n    var d = U(r);\n    if (!d || d.status !== 'ok'){ return; }\n    var c = d.config || {};\n    // Populate config inputs (skip any the user is currently editing).\n    $f('input[data-cfg]').each(function(){\n      var k = $(this).attr('data-cfg');\n      if (!me.loaded || this !== document.activeElement){ this.value = c[k] || ''; }\n    });\n    me.loaded = true;\n    // Step dots.\n    me.mark('materialize', d.kit_present);\n    me.mark('extract', d.src_extracted);\n    me.mark('patched', d.patched);\n    me.mark('deps', d.built);\n    me.mark('built', d.built);\n    me.updateMonitor(d.build_running, d.stage, d.build_pid, d.last_exit, d.log_tail);\n    if (d.build_running && !me.pollTimer) me.startPoll();\n  });\n};\n\nme.mark = function(step, done){\n  var li = $f('li[data-step=\"' + step + '\"]');\n  if (done) li.addClass('done'); else li.removeClass('done');\n};\n\nme.updateMonitor = function(running, stage, pid, lastExit, log){\n  $f('.nbld-run').toggle(!!running).text(running ? 'running' : '');\n  $f('[data-act=\"stop\"]').toggle(!!running);\n  var s = '';\n  if (running) s = 'stage: ' + (stage||'?') + '  (pid ' + (pid||'?') + ')';\n  else if (stage) s = 'last stage: ' + stage + (lastExit !== '' && lastExit != null ? '  → exit ' + lastExit : '');\n  $f('.nbld-stage').text(s);\n  if (log != null && log !== '') {\n    var pre = $f('.nbld-log')[0];\n    var atBottom = pre.scrollHeight - pre.scrollTop - pre.clientHeight < 40;\n    pre.textContent = log;\n    if (atBottom) pre.scrollTop = pre.scrollHeight;\n  }\n};\n\nme.startPoll = function(){\n  if (me.pollTimer) return;\n  me.pollTimer = setInterval(function(){\n    send_stage_log(80, function(r){\n      var d = U(r);\n      if (!d) return;\n      me.updateMonitor(d.running, d.stage, d.pid, d.last_exit, d.log_tail);\n      if (!d.running){ me.stopPoll(); me.refresh(); }\n    });\n  }, 2500);\n};\nme.stopPoll = function(){ if (me.pollTimer){ clearInterval(me.pollTimer); me.pollTimer = null; } };\n\nme.saveConfig = function(btn){\n  var inputs = $f('input[data-cfg]').toArray();\n  var msg = $f('.nbld-cfgmsg').text('Saving…').css('color', '#7fd18f');\n  $(btn).prop('disabled', true);\n  var i = 0;\n  (function next(){\n    if (i >= inputs.length){\n      $(btn).prop('disabled', false);\n      msg.text('Saved.');\n      setTimeout(function(){ msg.text(''); }, 2500);\n      me.refresh();\n      return;\n    }\n    var el = inputs[i++];\n    send_set_config($(el).attr('data-cfg'), el.value.trim(), function(r){\n      var d = U(r);\n      if (d && d.status === 'err'){ msg.text(d.msg || 'error').css('color', '#e08a8a'); }\n      next();\n    });\n  })();\n};\n\nme.runStage = function(stage, btn){\n  $(btn).prop('disabled', true);\n  var done = function(r){\n    $(btn).prop('disabled', false);\n    var d = U(r);\n    if (d && d.status === 'err'){ alert('Noobscape: ' + (d.msg || 'stage failed')); }\n    me.refresh();\n    if (stage !== 'materialize' && stage !== 'patch') me.startPoll();\n  };\n  if (stage === 'materialize') send_materialize_kit(done);\n  else send_run_stage(stage, done);\n};\n\nme.doInstall = function(btn){\n  var mode = $f('input[name=\"nbmode\"]:checked').val() || 'symlink';\n  var msg = $f('.nbld-installmsg').text('Installing…').css('color', '#7fd18f');\n  $(btn).prop('disabled', true);\n  send_install(mode, function(r){\n    $(btn).prop('disabled', false);\n    var d = U(r);\n    if (d && d.status === 'ok'){ msg.text(d.msg || 'installed').css('color', '#7fd18f'); }\n    else { msg.text((d && d.msg) || 'install failed').css('color', '#e08a8a'); }\n    me.refresh();\n  });\n};\n\nme.stopBuild = function(btn){\n  $(btn).prop('disabled', true);\n  send_stop_build(function(r){\n    $(btn).prop('disabled', false);\n    me.stopPoll();\n    me.refresh();\n  });\n};","old":"","patch_id":"p3","time":1787744558123}]},"id":"uopxgj1a03ddb4a10j1e_patches","readers":[],"time":1787744558123,"username":"system","writers":[]}